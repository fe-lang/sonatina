#! evm.config: { vcode: true, bytecode_hex: false, stackify_trace: false, evm_trace: false, opt: 0 }
#! evm.case: ok
#!   calldata: u256(3) u256(9)
#!   expect: return u256(15)

target = "evm-ethereum-osaka"

type @slice = { i256, i256 };

func public %entry() {
    block0:
        v0.i256 = evm_calldata_load 0.i32;
        v1.i256 = evm_calldata_load 32.i32;
        v2.@slice = call %make v0 v1;
        v3.i256 = call %sum v2;
        v4.@slice = agg.make @slice v3 v0;
        v5.i256 = call %sum v4;
        mstore 0.i32 v5 i256;
        evm_return 0.i8 32.i8;
}

func private %make(v0.i256, v1.i256) -> @slice {
    block0:
        v2.@slice = agg.make @slice v0 v1;
        return v2;
}

func private %sum(v0.@slice) -> i256 {
    block0:
        v1.i256 = extract_value v0 0.i8;
        v2.i256 = extract_value v0 1.i8;
        v3.i256 = add v1 v2;
        return v3;
}

object @Contract {
  section runtime {
    entry %entry;
  }
}
