target = "evm-ethereum-osaka"
func public %entry() {
block0:
 v0.i256 = evm_calldata_load 0.i256;
 v1.i256 = add v0 100.i256;
 v2.i1 = eq v1 150.i256;
 v3.i256 = zext v2 i256;
 mstore 0.i256 v3 i256;
 evm_return 0.i256 32.i256;
}
object @Contract {
 section runtime { entry %entry; }
}
