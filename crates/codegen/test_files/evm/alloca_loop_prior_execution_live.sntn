#! evm.config: { vcode: true, opt: 0 }
#! evm.case: ok
#!   calldata:
#!   expect: return u256(304)

target = "evm-ethereum-osaka"

# Every execution of an alloca reuses one static slot. `v3`'s alloca runs again
# while `v1` still points at the previous iteration's object, so that object
# must stay live across the alloca: `v10` must not take its slot.

func public %entry() {
    block0:
        v0.i256 = call %f;
        mstore 0.i32 v0 i256;
        evm_return 0.i8 32.i8;
}

func private %f() -> i256 {
    block0:
        v0.*i256 = alloca i256;
        mstore v0 7.i256 i256;
        jump block1;

    block1:
        v1.*i256 = phi (v0 block0) (v3 block1);
        v2.i32 = phi (0.i32 block0) (v6 block1);
        v10.*i256 = alloca i256;
        mstore v10 99.i256 i256;
        v11.i256 = mload v10 i256;
        v3.*i256 = alloca i256;
        v4.i256 = mload v1 i256;
        v5.i256 = add v4 v11;
        mstore v3 v5 i256;
        v6.i32 = add v2 1.i32;
        v7.i1 = lt v6 3.i32;
        br v7 block1 block2;

    block2:
        v8.i256 = mload v3 i256;
        return v8;
}

object @Contract {
  section runtime {
    entry %entry;
  }
}
