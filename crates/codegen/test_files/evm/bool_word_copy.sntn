#! evm.config: { vcode: true, opt: 2 }
#! evm.case: scalar_false
#!   calldata: u256(0) u256(0)
#!   expect: return u256(0)
#! evm.case: scalar_true
#!   calldata: u256(1) u256(0)
#!   expect: return u256(1)
#! evm.case: member_false
#!   calldata: u256(0) u256(1)
#!   expect: return u256(0)
#! evm.case: member_true
#!   calldata: u256(1) u256(1)
#!   expect: return u256(1)

target = "evm-ethereum-osaka"

type @B = { i1, i256 };

# A canonical `i1` word (0 or 1 under R3) in an `i1` slot is copied to another
# slot, then read back and branched on with no mask.
func public %entry() {
    block0:
        v0.i256 = evm_calldata_load 0.i32;
        mstore 4096.i32 v0 i256;
        v1.i256 = evm_calldata_load 32.i32;
        v2.i1 = is_zero v1;
        br v2 block1 block2;

    block1:
        call %copy_scalar;
        jump block3;

    block2:
        call %copy_member;
        jump block3;

    block3:
        v3.i256 = call %branch_on_copy;
        mstore 0.i32 v3 i256;
        evm_return 0.i32 32.i32;
}

# Only a store of it as an `i1` uses the read.
func inline(never) private %copy_scalar() {
    block0:
        v0.i1 = mload 4096.i32 i1;
        mstore 8192.i32 v0 i1;
        return;
}

# Only an insert into an `i1` member uses the read.
func inline(never) private %copy_member() {
    block0:
        v0.@B = mload 4096.i32 @B;
        v1.i1 = extract_value v0 0.i8;
        v2.@B = mload 12288.i32 @B;
        v3.@B = insert_value v2 0.i8 v1;
        mstore 8192.i32 v3 @B;
        return;
}

func inline(never) private %branch_on_copy() -> i256 {
    block0:
        v0.i1 = mload 8192.i32 i1;
        br v0 block1 block2;

    block1:
        return 1.i256;

    block2:
        return 0.i256;
}

object @Contract {
  section runtime {
    entry %entry;
  }
}
