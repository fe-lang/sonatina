#! evm.config: { vcode: true, bytecode_hex: false, stackify_trace: false, evm_trace: false }
#! evm.case: inputs_3_0
#!   calldata: u256(3) u256(0)
#!   expect: return u256(10) u256(100) u256(1000)
#! evm.case: inputs_10_4
#!   calldata: u256(10) u256(4)
#!   expect: return u256(20) u256(200) u256(5000)
#! evm.case: inputs_2_5
#!   calldata: u256(2) u256(5)
#!   expect: return u256(10) u256(300) u256(6000)
#! evm.case: inputs_7_9
#!   calldata: u256(7) u256(9)
#!   expect: return u256(20) u256(100) u256(4000)

target = "evm-ethereum-osaka"

# An exhaustive `br_table` without a default over `Type::EnumTag` (A.5): 2, 3,
# and 6 variants. The last case becomes the default when tags are lowered.

type @Two = enum { #A, #B };
type @Three = enum { #A, #B, #C };
type @Six = enum { #A, #B, #C, #D, #E, #F };

func private %by_flag(v0.i256) -> i256 {
    block0:
        v1.i1 = lt v0 5.i256;
        br v1 block3 block4;

    block3:
        v2.@Two = enum.make @Two #B ();
        jump block5;

    block4:
        v3.@Two = enum.make @Two #A ();
        jump block5;

    block5:
        v4.@Two = phi (v2 block3) (v3 block4);
        v5.enumtag(@Two) = enum.tag v4;
        br_table v5 (1.enumtag(@Two) block1) (0.enumtag(@Two) block2);

    block1:
        return 10.i256;

    block2:
        return 20.i256;
}

func private %by_three(v0.i256) -> i256 {
    block0:
        v1.i256 = umod v0 3.i256;
        br_table v1 block6 (0.i256 block4) (1.i256 block5);

    block4:
        v2.@Three = enum.make @Three #A ();
        jump block7;

    block5:
        v3.@Three = enum.make @Three #B ();
        jump block7;

    block6:
        v4.@Three = enum.make @Three #C ();
        jump block7;

    block7:
        v5.@Three = phi (v2 block4) (v3 block5) (v4 block6);
        v6.enumtag(@Three) = enum.tag v5;
        br_table v6 (0.enumtag(@Three) block1) (1.enumtag(@Three) block2) (2.enumtag(@Three) block3);

    block1:
        return 100.i256;

    block2:
        return 200.i256;

    block3:
        return 300.i256;
}

func private %by_six(v0.i256) -> i256 {
    block0:
        v1.i256 = umod v0 6.i256;
        br_table v1 block12 (0.i256 block7) (1.i256 block8) (2.i256 block9) (3.i256 block10) (4.i256 block11);

    block7:
        v2.@Six = enum.make @Six #A ();
        jump block13;

    block8:
        v3.@Six = enum.make @Six #B ();
        jump block13;

    block9:
        v4.@Six = enum.make @Six #C ();
        jump block13;

    block10:
        v5.@Six = enum.make @Six #D ();
        jump block13;

    block11:
        v6.@Six = enum.make @Six #E ();
        jump block13;

    block12:
        v7.@Six = enum.make @Six #F ();
        jump block13;

    block13:
        v8.@Six = phi (v2 block7) (v3 block8) (v4 block9) (v5 block10) (v6 block11) (v7 block12);
        v9.enumtag(@Six) = enum.tag v8;
        br_table v9 (0.enumtag(@Six) block1) (1.enumtag(@Six) block2) (2.enumtag(@Six) block3) (3.enumtag(@Six) block4) (4.enumtag(@Six) block5) (5.enumtag(@Six) block6);

    block1:
        return 1000.i256;

    block2:
        return 2000.i256;

    block3:
        return 3000.i256;

    block4:
        return 4000.i256;

    block5:
        return 5000.i256;

    block6:
        return 6000.i256;
}

func public %entry() {
    block0:
        v0.i256 = evm_calldata_load 0.i32;
        v1.i256 = evm_calldata_load 32.i32;
        v2.i256 = call %by_flag v0;
        v3.i256 = call %by_three v1;
        v4.i256 = call %by_six v1;
        mstore 0.i32 v2 i256;
        mstore 32.i32 v3 i256;
        mstore 64.i32 v4 i256;
        evm_return 0.i32 96.i32;
}

object @Contract {
  section runtime {
    entry %entry;
  }
}
