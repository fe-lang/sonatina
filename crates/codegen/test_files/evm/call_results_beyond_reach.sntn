#! evm.config: { stack_reach: 1, vcode: true }
#! evm.case: ok
#!   calldata: u256(7)
#!   expect: return u256(7) u256(8)

target = "evm-ethereum-osaka"

# With a reach of one, the second result of `%pair` is out of DUP reach. It
# stays on the stack, so nothing stores it and no DUP of it is planned.

func private %pair(v0.i256) -> (i256, i256) {
    block0:
        v1.i256 = add v0 1.i256;
        return (v0, v1);
}

func public %entry() {
    block0:
        v0.i256 = evm_calldata_load 0.i32;
        (v1.i256, v2.i256) = call %pair v0;
        mstore 0.i32 v1 i256;
        mstore 32.i32 v2 i256;
        evm_return 0.i32 64.i32;
}

object @Contract {
  section runtime {
    entry %entry;
  }
}
