#! evm.case: preserve_callee_allocation
#!   calldata: u256(32)
#!   expect: return u256(11) u256(99) u256(7)

target = "evm-ethereum-osaka"

func private %publish(v0.i256, v3.i256) {
    block0:
        v1.*i8 = evm_malloc v3;
        mstore v1 11.i256 i256;
        v2.i256 = ptr_to_int v1 i256;
        mstore v0 v2 i256;
        return;
}

func private %publish_through_box(v0.i256, v2.i256) {
    block0:
        v1.i256 = mload v0 i256;
        call %publish v1 v2;
        return;
}

func private %forward(v0.i256, v3.i256) -> i256 {
    block0:
        v1.*i8 = evm_malloc 32.i256;
        v2.i256 = ptr_to_int v1 i256;
        mstore v2 v0 i256;
        call %publish_through_box v2 v3;
        return 7.i256;
}

func private %overwrite() -> *i8 {
    block0:
        v0.*i8 = evm_malloc 64.i256;
        v1.*i8 = gep v0 32.i256;
        mstore v0 99.i256 i256;
        mstore v1 99.i256 i256;
        return v0;
}

func public %entry() {
    block0:
        mstore 64.i256 4096.i256 i256;
        v0.*i256 = alloca i256;
        v7.i256 = evm_calldata_load 0.i256;
        v8.i256 = ptr_to_int v0 i256;
        v1.i256 = call %forward v8 v7;
        v2.*i8 = call %overwrite;
        v3.i256 = mload v0 i256;
        v4.*i256 = int_to_ptr v3 *i256;
        v5.i256 = mload v4 i256;
        v6.i256 = mload v2 i256;
        mstore 0.i256 v5 i256;
        mstore 32.i256 v6 i256;
        mstore 64.i256 v1 i256;
        evm_return 0.i256 96.i256;
}

object @Contract {
    section runtime {
        entry %entry;
    }
}
