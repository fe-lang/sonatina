#! evm.config: { stack_reach: 4, vcode: true }
#! evm.case: one_level
#!   calldata: u256(2) u256(10) u256(20) u256(30) u256(40) u256(50)
#!   expect: return u256(300)

target = "evm-ethereum-osaka"

# `%rec`'s entry block is a loop header, and `%rec` keeps values in its
# dynamic frame across the recursive call. The back edge must not enter the
# frame again, or the callee's return leaves DYN_SP above the caller's frame.
func private %rec(v0.*i256, v1.i256) -> i256 {
block0:
    v2.i256 = mload v0 i256;
    v3.i256 = add v2 1.i256;
    mstore v0 v3 i256;
    v4.i1 = lt v3 3.i256;
    br v4 block0 block1;

block1:
    mstore v0 0.i256 i256;
    v30.i256 = evm_calldata_load 32.i32;
    v5.i256 = call %id v30;
    v31.i256 = evm_calldata_load 64.i32;
    v6.i256 = call %id v31;
    v32.i256 = evm_calldata_load 96.i32;
    v7.i256 = call %id v32;
    v33.i256 = evm_calldata_load 128.i32;
    v8.i256 = call %id v33;
    v34.i256 = evm_calldata_load 160.i32;
    v9.i256 = call %id v34;
    v10.i1 = eq v1 0.i256;
    br v10 block2 block3;

block2:
    return v1;

block3:
    v11.i256 = sub v1 1.i256;
    v12.i256 = call %rec v0 v11;
    v13.i256 = add v5 v6;
    v14.i256 = add v13 v7;
    v15.i256 = add v14 v8;
    v16.i256 = add v15 v9;
    v17.i256 = add v16 v12;
    return v17;
}

func private %id(v0.i256) -> i256 {
block0:
    return v0;
}

func public %entry() {
block0:
    v0.i256 = evm_calldata_load 0.i32;
    v1.*i256 = alloca i256;
    mstore v1 0.i256 i256;
    v2.i256 = call %rec v1 v0;
    mstore 0.i32 v2 i256;
    evm_return 0.i8 32.i8;
}

object @Contract {
  section runtime {
    entry %entry;
  }
}
