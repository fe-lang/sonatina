#! evm.config: { mem_plan_detail: true }
#! evm.case: ok
#!   calldata: u256(1)
#!   expect: return u256(4831)

# Two phases each keep 20 values live across an internal call. The phases'
# spills are never live at the same time, so they share stable words.

target = "evm-ethereum-osaka"

func public %entry() {
    block0:
        v0.i256 = evm_calldata_load 0.i32;
        v1.i256 = call %phases v0;
        mstore 0.i256 v1 i256;
        evm_return 0.i256 32.i256;
}

func private %one() -> i256 {
    block0:
        v0.*[i256; 2] = alloca [i256; 2];
        v1.i256 = ptr_to_int v0 i256;
        mstore v1 1.i256 i256;
        v2.i256 = mload v1 i256;
        return v2;
}

func private %phases(v0.i256) -> i256 {
    block0:
        v1.i256 = add v0 1.i256;
        v2.i256 = add v0 2.i256;
        v3.i256 = add v0 3.i256;
        v4.i256 = add v0 4.i256;
        v5.i256 = add v0 5.i256;
        v6.i256 = add v0 6.i256;
        v7.i256 = add v0 7.i256;
        v8.i256 = add v0 8.i256;
        v9.i256 = add v0 9.i256;
        v10.i256 = add v0 10.i256;
        v11.i256 = add v0 11.i256;
        v12.i256 = add v0 12.i256;
        v13.i256 = add v0 13.i256;
        v14.i256 = add v0 14.i256;
        v15.i256 = add v0 15.i256;
        v16.i256 = add v0 16.i256;
        v17.i256 = add v0 17.i256;
        v18.i256 = add v0 18.i256;
        v19.i256 = add v0 19.i256;
        v20.i256 = add v0 20.i256;
        v21.i256 = call %one;
        v22.i256 = add v21 v1;
        v23.i256 = add v22 v2;
        v24.i256 = add v23 v3;
        v25.i256 = add v24 v4;
        v26.i256 = add v25 v5;
        v27.i256 = add v26 v6;
        v28.i256 = add v27 v7;
        v29.i256 = add v28 v8;
        v30.i256 = add v29 v9;
        v31.i256 = add v30 v10;
        v32.i256 = add v31 v11;
        v33.i256 = add v32 v12;
        v34.i256 = add v33 v13;
        v35.i256 = add v34 v14;
        v36.i256 = add v35 v15;
        v37.i256 = add v36 v16;
        v38.i256 = add v37 v17;
        v39.i256 = add v38 v18;
        v40.i256 = add v39 v19;
        v41.i256 = add v40 v20;
        v42.i256 = add v41 1.i256;
        v43.i256 = add v41 2.i256;
        v44.i256 = add v41 3.i256;
        v45.i256 = add v41 4.i256;
        v46.i256 = add v41 5.i256;
        v47.i256 = add v41 6.i256;
        v48.i256 = add v41 7.i256;
        v49.i256 = add v41 8.i256;
        v50.i256 = add v41 9.i256;
        v51.i256 = add v41 10.i256;
        v52.i256 = add v41 11.i256;
        v53.i256 = add v41 12.i256;
        v54.i256 = add v41 13.i256;
        v55.i256 = add v41 14.i256;
        v56.i256 = add v41 15.i256;
        v57.i256 = add v41 16.i256;
        v58.i256 = add v41 17.i256;
        v59.i256 = add v41 18.i256;
        v60.i256 = add v41 19.i256;
        v61.i256 = add v41 20.i256;
        v62.i256 = call %one;
        v63.i256 = add v62 v42;
        v64.i256 = add v63 v43;
        v65.i256 = add v64 v44;
        v66.i256 = add v65 v45;
        v67.i256 = add v66 v46;
        v68.i256 = add v67 v47;
        v69.i256 = add v68 v48;
        v70.i256 = add v69 v49;
        v71.i256 = add v70 v50;
        v72.i256 = add v71 v51;
        v73.i256 = add v72 v52;
        v74.i256 = add v73 v53;
        v75.i256 = add v74 v54;
        v76.i256 = add v75 v55;
        v77.i256 = add v76 v56;
        v78.i256 = add v77 v57;
        v79.i256 = add v78 v58;
        v80.i256 = add v79 v59;
        v81.i256 = add v80 v60;
        v82.i256 = add v81 v61;
        return v82;
}

object @Contract {
  section runtime {
    entry %entry;
  }
}
