#! evm.config: { stack_reach: 4, mem_plan_detail: true, vcode: true }
#! evm.case: ok
#!   calldata: u256(10)
#!   expect: return u256(2541)

# `%spin`'s entry block is a loop header. Its argument spills are stored on
# entry, so the back edge to block0 re-runs those stores. The spills after the
# loop reuse the argument words, which are dead by then.

target = "evm-ethereum-osaka"

func public %entry() {
    block0:
        v0.i256 = evm_calldata_load 0.i32;
        v1.*i256 = alloca i256;
        mstore v1 0.i256 i256;
        v2.i256 = add v0 1.i256;
        v3.i256 = add v0 2.i256;
        v4.i256 = add v0 3.i256;
        v5.i256 = add v0 4.i256;
        v6.i256 = call %spin v1 v0 v2 v3 v4 v5;
        mstore 0.i256 v6 i256;
        evm_return 0.i256 32.i256;
}

func private %one() -> i256 {
    block0:
        v0.*[i256; 2] = alloca [i256; 2];
        v1.i256 = ptr_to_int v0 i256;
        mstore v1 1.i256 i256;
        v2.i256 = mload v1 i256;
        return v2;
}

func private %spin(v0.*i256, v1.i256, v2.i256, v3.i256, v4.i256, v5.i256) -> i256 {
    block0:
        v6.i256 = mload v0 i256;
        v7.i256 = call %one;
        v28.i256 = add v5 v7;
        v29.i256 = add v28 v4;
        v30.i256 = add v29 v3;
        v31.i256 = add v30 v2;
        v32.i256 = add v31 v1;
        v8.i256 = add v6 v32;
        mstore v0 v8 i256;
        v9.i1 = lt v8 200.i256;
        br v9 block0 block1;

    block1:
        v14.i256 = add v8 v1;
        v15.i256 = add v14 1.i256;
        v16.i256 = add v14 2.i256;
        v17.i256 = add v14 3.i256;
        v18.i256 = add v14 4.i256;
        v19.i256 = add v14 5.i256;
        v20.i256 = add v14 6.i256;
        v10.i256 = add v14 7.i256;
        v11.i256 = add v14 8.i256;
        v21.i256 = call %one;
        v22.i256 = add v21 v15;
        v23.i256 = add v22 v16;
        v24.i256 = add v23 v17;
        v25.i256 = add v24 v18;
        v26.i256 = add v25 v19;
        v27.i256 = add v26 v20;
        v12.i256 = add v27 v10;
        v13.i256 = add v12 v11;
        v33.i256 = xor v13 v11;
        v34.i256 = xor v33 v10;
        v35.i256 = xor v34 v20;
        v36.i256 = xor v35 v19;
        v37.i256 = xor v36 v18;
        v38.i256 = xor v37 v17;
        v39.i256 = xor v38 v16;
        v40.i256 = xor v39 v15;
        return v40;
}

object @Contract {
  section runtime {
    entry %entry;
  }
}
