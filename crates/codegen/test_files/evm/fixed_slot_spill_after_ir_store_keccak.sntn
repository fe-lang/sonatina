#! evm.config: { vcode: true }
#! evm.case: hashes_key_and_slot
#!   calldata: u256(0x1000) u256(0x2000) u256(0)
#!   expect: return u256(0x0cae7a53faa4d416aeae6ed0cb16440a68527554c6b4d1d97857a5ff91a67fc0)

# Mapping-slot hashing at 0x00: `mstore 0 key`, the slot computed under stack pressure,
# `mstore 32 slot`, `keccak256 0 64`. No spill between the stores may use a fixed slot.
target = "evm-ethereum-osaka"

func public %entry() {
block0:
    v0.i256 = evm_calldata_load 0.i256;
    v90.i256 = evm_calldata_load 32.i256;
    evm_mstore 0.i256 v0;
    v1.i256 = add v0 1.i256;
    v2.i256 = add v0 2.i256;
    v3.i256 = add v0 3.i256;
    v4.i256 = add v0 4.i256;
    v5.i256 = add v0 5.i256;
    v6.i256 = add v0 6.i256;
    v7.i256 = add v0 7.i256;
    v8.i256 = add v0 8.i256;
    v9.i256 = add v0 9.i256;
    v10.i256 = add v0 10.i256;
    v11.i256 = add v0 11.i256;
    v12.i256 = add v0 12.i256;
    v13.i256 = add v0 13.i256;
    v14.i256 = add v0 14.i256;
    v15.i256 = add v0 15.i256;
    v16.i256 = add v0 16.i256;
    v17.i256 = add v0 17.i256;
    v18.i256 = add v0 18.i256;
    v19.i256 = add v0 19.i256;
    v20.i256 = add v0 20.i256;
    v200.i256 = add v0 v1;
    v201.i256 = add v200 v2;
    v202.i256 = add v201 v3;
    v203.i256 = add v202 v4;
    v204.i256 = add v203 v5;
    v205.i256 = add v204 v6;
    v206.i256 = add v205 v7;
    v207.i256 = add v206 v8;
    v208.i256 = add v207 v9;
    v209.i256 = add v208 v10;
    v210.i256 = add v209 v11;
    v211.i256 = add v210 v12;
    v212.i256 = add v211 v13;
    v213.i256 = add v212 v14;
    v214.i256 = add v213 v15;
    v215.i256 = add v214 v16;
    v216.i256 = add v215 v17;
    v217.i256 = add v216 v18;
    v218.i256 = add v217 v19;
    v219.i256 = add v218 v20;
    evm_mstore 32.i256 v219;
    v100.i256 = evm_keccak256 0.i256 64.i256;
    evm_mstore 256.i256 v100;
    evm_return 256.i256 32.i256;
}

object @Contract {
    section runtime {
        entry %entry;
    }
}
