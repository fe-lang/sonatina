#! evm.config: { vcode: true }
#! evm.case: one_iteration
#!   calldata: u256(1)
#!   expect: return u256(0)
#! evm.case: two_iterations
#!   calldata: u256(2)
#!   expect: return u256(0)

target = "evm-ethereum-osaka"

# `%f` restores the free pointer on return, and its entry block is a loop
# header. The restore must store the free pointer `%f` was called with, not
# the one the last iteration started with, so `%entry` sees no change after
# any number of iterations.
func private %f(v0.*i256, v1.i256) -> i256 {
block0:
    v2.*i256 = evm_malloc v1;
    mstore v2 42.i256 i256;
    v3.i256 = call %sink v2 v1;
    v4.i256 = mload v0 i256;
    v5.i256 = add v4 1.i256;
    mstore v0 v5 i256;
    v6.i1 = lt v5 v1;
    br v6 block0 block1;

block1:
    return v3;
}

func private %sink(v0.*i256, v1.i256) -> i256 {
block0:
    v2.*i256 = evm_malloc v1;
    v3.i256 = mload v0 i256;
    mstore v2 v3 i256;
    v4.i256 = evm_keccak256 v2 32.i256;
    return v4;
}

func public %entry() {
block0:
    v0.i256 = evm_calldata_load 0.i32;
    v1.*i256 = alloca i256;
    mstore v1 0.i256 i256;
    v2.i256 = mload 64.i32 i256;
    v3.i256 = call %f v1 v0;
    v4.i256 = mload 64.i32 i256;
    v5.i256 = sub v4 v2;
    mstore 0.i32 v5 i256;
    evm_return 0.i8 32.i8;
}

object @Contract {
  section runtime {
    entry %entry;
  }
}
