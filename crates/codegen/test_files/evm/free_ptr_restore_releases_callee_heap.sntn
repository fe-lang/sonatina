#! evm.config: { opt: 0 }
#! evm.case: ok
#!   calldata:
#!   expect: return u256(12) u256(32)

target = "evm-ethereum-osaka"

# `%f`'s buffer is live across a call that allocates, so it advances the free
# pointer, but nothing that outlives `%f` points into it: `%f` restores the
# free pointer on return, and `%entry`'s next malloc reuses its memory.

func public %entry() {
    block0:
        v20.i256 = evm_calldata_size;
        v21.i256 = add v20 32.i256;
        v0.*i256 = evm_malloc v21;
        mstore v0 5.i256 i256;
        v1.i256 = call %f v21;
        v2.*i256 = evm_malloc v21;
        mstore v2 v1 i256;
        v3.i256 = mload v0 i256;
        v4.i256 = mload v2 i256;
        v5.i256 = add v3 v4;
        v6.i256 = ptr_to_int v0 i256;
        v7.i256 = ptr_to_int v2 i256;
        v8.i256 = sub v7 v6;
        mstore 0.i32 v5 i256;
        mstore 32.i32 v8 i256;
        evm_return 0.i8 64.i8;
}

func private %f(v0.i256) -> i256 {
    block0:
        v1.*i256 = evm_malloc v0;
        mstore v1 7.i256 i256;
        call %g v0;
        v2.i256 = mload v1 i256;
        return v2;
}

func private %g(v0.i256) {
    block0:
        v1.*i256 = evm_malloc v0;
        mstore v1 1.i256 i256;
        return;
}

object @Contract {
  section runtime {
    entry %entry;
  }
}
