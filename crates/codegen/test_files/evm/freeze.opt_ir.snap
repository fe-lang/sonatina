---
source: crates/codegen/tests/evm.rs
expression: opt_ir_snapshot
input_file: test_files/evm/freeze.sntn
---
target = "evm-ethereum-osaka"

func public %entry() {
    block0:
        v0.i256 = evm_calldata_load 0.i32;
        v2.i256 = freeze v0;
        v1.i256 = evm_calldata_load 32.i32;
        v4.i1 = gt v2 v1;
        br v4 block1 block2;

    block1:
        v5.i256 = sub v2 v1;
        v3.i256 = freeze undef.i256;
        v6.i256 = add v5 v3;
        mstore 0.i256 v6 i256;
        evm_return 0.i256 32.i256;

    block2:
        mstore 0.i256 0.i256 i256;
        evm_return 0.i256 32.i256;
}


object @Contract {
    section runtime {
        entry %entry;
    }
}
