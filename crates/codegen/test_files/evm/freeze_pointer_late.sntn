#! evm.config: { opt: 2 }
#! evm.case: frozen_alloca
#!   calldata: u256(1) u256(9)
#!   expect: return u256(9)

target = "evm-ethereum-osaka"

# A freeze of a value that may be unspecified stays until the last IR pass, so
# here a frozen pointer reaches memory legalization and the cleanup after it.
func public %entry() {
    block0:
        v0.i256 = evm_calldata_load 0.i32;
        v1.i1 = ne v0 0.i256;
        v2.i256 = evm_calldata_load 32.i32;
        v3.i256 = call %store_through v1 v2;
        mstore 0.i32 v3 i256;
        evm_return 0.i8 32.i8;
}

func private %store_through(v0.i1, v1.i256) -> i256 {
    block0:
        v2.*i256 = alloca i256;
        br v0 block1 block2;

    block1:
        jump block3;

    block2:
        jump block3;

    block3:
        v3.*i256 = phi (v2 block1) (undef.*i256 block2);
        v4.*i256 = freeze v3;
        mstore v4 v1 i256;
        v5.i256 = mload v4 i256;
        return v5;
}

object @Contract {
  section runtime {
    entry %entry;
  }
}
