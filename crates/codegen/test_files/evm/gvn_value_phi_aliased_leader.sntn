#! evm.config: { opt: 2 }
#! evm.case: three
#!   calldata: u256(3)
#!   expect: return u256(3)
#! evm.case: five
#!   calldata: u256(5)
#!   expect: return u256(3)

# GVN resolves `v3` (`or` of a phi of constants) to a constant and erases it;
# `v4` is in `v3`'s class and must resolve to the replacement, not `v3`.

target = "evm-ethereum-osaka"

func public %f(v0.i256) -> i256 {
    block0:
        v1.i1 = eq v0 3.i256;
        br v1 block1 block2;

    block1:
        jump block2;

    block2:
        v2.i256 = phi (1.i256 block0) (0.i256 block1);
        v3.i256 = or v2 3.i256;
        v4.i256 = or v2 v3;
        return v4;
}

func public %entry() {
    block0:
        v0.i256 = evm_calldata_load 0.i256;
        v1.i256 = call %f v0;
        mstore 0.i256 v1 i256;
        evm_return 0.i256 32.i256;
}

object @Contract {
    section runtime {
        entry %entry;
    }
}
