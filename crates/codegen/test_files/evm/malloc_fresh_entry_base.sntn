#! evm.config: { vcode: true }
#! evm.case: ok
#!   calldata:
#!   expect: return u256(7) u256(32)

target = "evm-ethereum-osaka"

# The entry's first malloc runs while 0x40 still holds the zero execution
# starts with, so its base is the constant minimum; it must still advance the
# free pointer for the callee's allocation.
func public %entry() {
    block0:
        v0.*i256 = evm_malloc 32.i256;
        mstore v0 7.i256 i256;
        v1.*i256 = call %alloc_more;
        v2.i256 = mload v0 i256;
        v3.i256 = ptr_to_int v0 i256;
        v4.i256 = ptr_to_int v1 i256;
        v5.i256 = sub v4 v3;
        mstore 0.i32 v2 i256;
        mstore 32.i32 v5 i256;
        evm_return 0.i8 64.i8;
}

func private %alloc_more() -> *i256 {
    block0:
        v0.*i256 = evm_malloc 32.i256;
        mstore v0 9.i256 i256;
        return v0;
}

object @Contract {
  section runtime {
    entry %entry;
  }
}
