#! evm.config: { opt: 0 }
#! evm.case: dirty_words
#!   calldata: u256(384) u256(2) u256(384)
#!   expect: return u256(128) u256(0) u256(115792089237316195423570985008687907853269984665640564039457584007913129639808)

target = "evm-ethereum-osaka"

type @words = { i256, i256, i256 };
type @fields = { i8, i1, i8 };

# Memory is concrete: `%fresh`'s slot is never written, and holds whatever
# `%dirty` left in the memory it reuses. Reading a narrow field out of it
# normalizes the word, as a scalar `mload` does: `zext` of the `i8` field sees
# 0x80 of 0x180, the `i1` field sees 0 of 2, and `sext` of the signed field
# sees -128.
func public %entry() {
    block0:
        v0.i256 = evm_calldata_load 0.i32;
        v1.i256 = evm_calldata_load 32.i32;
        v2.i256 = evm_calldata_load 64.i32;
        call %dirty v0 v1 v2;
        call %fresh;
        evm_return 0.i32 96.i32;
}

func inline(never) private %dirty(v0.i256, v1.i256, v2.i256) {
    block0:
        v3.*@words = alloca @words;
        v4.@words = insert_value undef.@words 0.i8 v0;
        v5.@words = insert_value v4 1.i8 v1;
        v6.@words = insert_value v5 2.i8 v2;
        mstore v3 v6 @words;
        evm_sstore 0.i256 v3;
        return;
}

func inline(never) private %fresh() {
    block0:
        v0.*@fields = alloca @fields;
        v1.@fields = mload v0 @fields;
        v2.i8 = extract_value v1 0.i8;
        v3.i1 = extract_value v1 1.i8;
        v4.i8 = extract_value v1 2.i8;
        v5.i8 = freeze v2;
        v6.i1 = freeze v3;
        v7.i8 = freeze v4;
        v8.i256 = zext v5 i256;
        v9.i256 = zext v6 i256;
        v10.i256 = sext v7 i256;
        mstore 0.i32 v8 i256;
        mstore 32.i32 v9 i256;
        mstore 64.i32 v10 i256;
        return;
}

object @Contract {
  section runtime {
    entry %entry;
  }
}
