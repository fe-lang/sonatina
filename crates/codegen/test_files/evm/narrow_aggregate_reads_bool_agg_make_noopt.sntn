#! evm.config: { opt: 0 }
#! evm.case: bool_members
#!   calldata: u256(1) u256(3)
#!   expect: return u256(1) u256(0) u256(1)

target = "evm-ethereum-osaka"

type @B = { i1, i256 };

# An `i1` operand of an `agg.make` is stored as the word it widens to, and the
# member read back from memory keeps the low bit. The slots start dirty with 3:
# the zero `i1` operand overwrites that word, so its member reads `false`; had
# it stored nothing, the member would read the low bit of 3, `true`. `%array`
# builds a `[i1; 2]`, whose type legalizes to `[i256; 2]`.
func public %entry() {
    block0:
        v0.i256 = evm_calldata_load 0.i32;
        v1.i256 = evm_calldata_load 32.i32;
        mstore 4096.i32 v1 i256;
        mstore 4160.i32 v1 i256;
        call %store v0;
        call %store_zero;
        call %array v0;
        v2.i256 = call %read 4096.i32;
        v3.i256 = call %read 4160.i32;
        v4.i256 = call %read_element;
        mstore 0.i32 v2 i256;
        mstore 32.i32 v3 i256;
        mstore 64.i32 v4 i256;
        evm_return 0.i32 96.i32;
}

func inline(never) private %store(v0.i256) {
    block0:
        v1.i1 = eq v0 1.i256;
        v2.@B = agg.make @B v1 7.i256;
        mstore 4096.i32 v2 @B;
        return;
}

func inline(never) private %store_zero() {
    block0:
        v0.@B = agg.make @B 0.i1 9.i256;
        mstore 4160.i32 v0 @B;
        return;
}

func inline(never) private %array(v0.i256) {
    block0:
        v1.i1 = eq v0 1.i256;
        v2.i1 = eq v0 0.i256;
        v3.[i1; 2] = agg.make [i1; 2] v2 v1;
        mstore 4224.i32 v3 [i1; 2];
        return;
}

func inline(never) private %read(v0.i32) -> i256 {
    block0:
        v1.@B = mload v0 @B;
        v2.i1 = extract_value v1 0.i8;
        v4.i256 = zext v2 i256;
        return v4;
}

func inline(never) private %read_element() -> i256 {
    block0:
        v0.[i1; 2] = mload 4224.i32 [i1; 2];
        v1.i1 = extract_value v0 1.i8;
        v2.i256 = zext v1 i256;
        return v2;
}

object @Contract {
  section runtime {
    entry %entry;
  }
}
