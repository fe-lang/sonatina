#! evm.config: { opt: 0 }
#! evm.case: callee_length
#!   calldata: u256(288) u256(1)
#!   expect: return u256(0)
#! evm.case: callee_freeze
#!   calldata: u256(288) u256(2)
#!   expect: return u256(32)

target = "evm-ethereum-osaka"

type @words = { i256 };
type @fields = { i8 };

# `%field` returns, unfrozen, the `i8` read from a slot last written as the `i256` word 288.
# `%use_length` takes it as a parameter and uses it as a length; `%use_freeze` freezes it and
# returns its `zext`, which must be below 256.
func public %entry() {
    block0:
        v0.i256 = evm_calldata_load 0.i32;
        v1.i256 = evm_calldata_load 32.i32;
        v2.i8 = call %field v0;
        br_table v1 block9 (1.i256 block1) (2.i256 block2);

    block1:
        call %use_length v2;
        evm_return 0.i32 0.i32;

    block2:
        v3.i256 = call %use_freeze v2;
        mstore 0.i32 v3 i256;
        evm_return 0.i32 32.i32;

    block9:
        evm_return 0.i32 0.i32;
}

func inline(never) private %field(v9.i256) -> i8 {
    block0:
        v7.*@words = alloca @words;
        v8.@words = insert_value undef.@words 0.i8 v9;
        mstore v7 v8 @words;
        v0.*@fields = bitcast v7 *@fields;
        v1.@fields = mload v0 @fields;
        v2.i8 = extract_value v1 0.i8;
        return v2;
}

func inline(never) private %use_length(v0.i8) {
    block0:
        v1.*i8 = evm_malloc 512.i256;
        evm_return v1 v0;
}

func inline(never) private %use_freeze(v0.i8) -> i256 {
    block0:
        v1.i8 = freeze v0;
        v2.i256 = zext v1 i256;
        return v2;
}

object @Contract {
  section runtime {
    entry %entry;
  }
}
