#! evm.config: { opt: 0 }
#! evm.case: dirty_length
#!   calldata: u256(288)
#!   expect: return u256(0)

target = "evm-ethereum-osaka"

type @words = { i256 };
type @fields = { i8 };

# `%fresh`'s slot is never written and holds the 288 (0x120) `%dirty` left. Its
# field is the unspecified `i8`, used unfrozen as the length of `evm_return`.
# The `i8` length is at most 255, so at most 255 bytes come back.
func public %entry() {
    block0:
        v0.i256 = evm_calldata_load 0.i32;
        call %dirty v0;
        call %fresh;
        evm_return 0.i32 32.i32;
}

func inline(never) private %dirty(v0.i256) {
    block0:
        v3.*@words = alloca @words;
        v4.@words = insert_value undef.@words 0.i8 v0;
        mstore v3 v4 @words;
        evm_sstore 0.i256 v3;
        return;
}

func inline(never) private %fresh() {
    block0:
        v0.*@fields = alloca @fields;
        v1.@fields = mload v0 @fields;
        v2.i8 = extract_value v1 0.i8;
        v3.*i8 = evm_malloc 256.i256;
        evm_return v3 v2;
}

object @Contract {
  section runtime {
    entry %entry;
  }
}
