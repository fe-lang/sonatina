        v4.*i8 = evm_malloc 1024.i256;
        evm_mcopy v4 v3 v2;
        v9.i256 = evm_msize;
        v90.i256 = ptr_to_int v0 i256;
        v91.i256 = evm_mload v90;
        v92.i256 = shl 128.i256 v9;
        v93.i256 = or v92 v91;
