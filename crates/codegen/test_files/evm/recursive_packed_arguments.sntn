        v30.objref<i256> = obj.proj v16 12.i256;
        obj.store v30 12.i256;
        v31.objref<i256> = obj.proj v16 13.i256;
        obj.store v31 13.i256;
        v32.objref<i256> = obj.proj v16 14.i256;
