# Fe packs depth and sixteen live arguments into an object passed recursively.
# The base-case return must restore the caller frame before it reloads spills.
target = "evm-ethereum-osaka"

type @recursive__args = {i256, i256, i256, i256, i256, i256, i256, i256, i256, i256, i256, i256, i256, i256, i256, i256, i256};

func public %entry() {
    block0:
