---
source: crates/codegen/tests/evm.rs
expression: opt_ir_snapshot
input_file: test_files/evm/scalar_object_loop.sntn
---
target = "evm-ethereum-osaka"

func public %entry() {
    block0:
        v0.i256 = evm_calldata_load 0.i256;
        v1.i256 = evm_calldata_load 32.i256;
        jump block1;

    block1:
        v16.i256 = phi (v1 block0) (v6 block3);
        v3.i256 = phi (0.i256 block0) (v8 block3);
        v4.i1 = lt v3 v0;
        br v4 block2 block4;

    block2:
        (v6.i256, v7.i1) = uaddo v16 v3;
        br v7 block5 block3;

    block3:
        v8.i256 = add v3 1.i256;
        jump block1;

    block4:
        mstore 0.i256 v16 i256;
        evm_return 0.i256 32.i256;

    block5:
        evm_revert 0.i256 0.i256;
}


object @Contract {
    section runtime {
        entry %entry;
    }
}
