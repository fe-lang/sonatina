    block0:
        v0.i256 = evm_calldata_load 0.i256;
        v24.i1 = is_zero v0;
        v1.i256 = evm_calldata_load 32.i256;
        br v24 block4 block3;

    block7:
        (v31.i256, v32.i1) = uaddo v27 v8;
        br v32 block5 block3;

