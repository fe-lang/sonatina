func public %entry() {
    block0:
        v0.i256 = evm_calldata_load 0.i256;
        v26.i1 = is_zero v0;
        v1.i256 = evm_calldata_load 32.i256;
        br v26 block4 block3;

    block7:
        (v33.i256, v34.i1) = uaddo v29 v8;
        br v34 block5 block3;

    block3:
        v30.i256 = phi (0.i256 block0) (v8 block7);
        v29.i256 = phi (v1 block0) (v33 block7);
        v8.i256 = add v30 1.i256;
