    block0:
        v0.i256 = evm_calldata_load 0.i256;
        v28.i1 = is_zero v0;
        v1.i256 = evm_calldata_load 32.i256;
        br v28 block4 block3;

    block7:
        (v35.i256, v36.i1) = uaddo v31 v8;
        br v36 block5 block3;

