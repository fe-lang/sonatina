#! evm.config: { stack_reach: 4, vcode: true }
#! evm.case: one_trip
#!   calldata: u256(1) u256(5)
#!   expect: return u256(24)
#! evm.case: four_trips
#!   calldata: u256(4) u256(5)
#!   expect: return u256(132)

# v2 feeds the phi v6 on the back edge and is used after the loop. Both uses
# lie past the loop header, so v2 is reloaded at each and its store takes it
# off the stack. The phi sources defined in the loop body are stored from
# copies: the back edge takes them from the stack.

target = "evm-ethereum-osaka"

func public %entry() {
    block0:
        v0.i256 = evm_calldata_load 0.i32;
        v1.i256 = evm_calldata_load 32.i32;
        v2.i256 = call %rot v0 v1;
        mstore 0.i256 v2 i256;
        evm_return 0.i256 32.i256;
}

func private %rot(v0.i256, v1.i256) -> i256 {
    block0:
        v2.i256 = add v1 7.i256;
        jump block1;

    block1:
        v3.i256 = phi (0.i256 block0) (v20 block1);
        v4.i256 = phi (v0 block0) (v10 block1);
        v5.i256 = phi (v1 block0) (v10 block1);
        v6.i256 = phi (1.i256 block0) (v2 block1);
        v7.i256 = phi (2.i256 block0) (v11 block1);
        v8.i256 = phi (3.i256 block0) (v12 block1);
        v10.i256 = add v4 v5;
        v11.i256 = add v7 v6;
        v12.i256 = add v8 v3;
        v20.i256 = add v3 1.i256;
        v21.i1 = lt v20 v0;
        br v21 block1 block2;

    block2:
        v22.i256 = add v10 v11;
        v23.i256 = add v22 v12;
        v24.i256 = add v23 v2;
        return v24;
}

object @Contract {
  section runtime {
    entry %entry;
  }
}
