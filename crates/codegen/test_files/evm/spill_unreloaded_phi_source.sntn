#! evm.config: { mem_plan_detail: true }
#! evm.case: ok
#!   calldata: u256(256) u256(513) u256(770) u256(1027) u256(1284) u256(1541)
#!   expect: return u256(57572)

# The loop's next values feed the header's spilled phis on the back edge. A first
# plan reloads them there and spills them. Once the phis are spilled the edge reaches
# each of them on the stack, so they are not stored after their definitions.
target = "evm-ethereum-osaka"

func public %entry() {
block0:
    v0.i256 = evm_calldata_load 0.i256;
    v1.i256 = evm_calldata_load 32.i256;
    v2.i256 = evm_calldata_load 64.i256;
    v3.i256 = evm_calldata_load 96.i256;
    v4.i256 = evm_calldata_load 128.i256;
    v5.i256 = evm_calldata_load 160.i256;
    v6.i256 = call %f v0 v1 v2 v3 v4 v5;
    evm_mstore 0.i256 v6;
    evm_return 0.i256 32.i256;
}

func private %f(v0.i256, v1.i256, v2.i256, v3.i256, v4.i256, v5.i256) -> i256 {
block0:
    v6.i256 = add v3 v5;
    v7.i256 = add v4 v4;
    v8.i256 = add v2 9.i256;
    v9.i256 = add v8 v6;
    jump block1;
block1:
    v10.i256 = phi (v3 block0) (v16 block2);
    v11.i256 = phi (v4 block0) (v17 block2);
    v12.i256 = phi (v0 block0) (v18 block2);
    v13.i256 = phi (v8 block0) (v19 block2);
    v14.i256 = phi (v5 block0) (v20 block2);
    v15.i256 = phi (v3 block0) (v21 block2);
    v22.i256 = phi (0.i256 block0) (v23 block2);
    v24.i1 = lt v22 3.i256;
    br v24 block2 block3;
block2:
    v16.i256 = add v7 v10;
    v17.i256 = add v3 v11;
    v18.i256 = add v5 v12;
    v19.i256 = add v9 v13;
    v20.i256 = add v7 v14;
    v21.i256 = add v4 v15;
    v23.i256 = add v22 1.i256;
    jump block1;
block3:
    v25.i256 = add v0 v14;
    v26.i256 = add v25 v7;
    v27.i256 = add v26 v10;
    v28.i256 = add v27 v1;
    v29.i256 = add v28 v5;
    v30.i256 = add v29 v11;
    v31.i256 = add v30 v15;
    v32.i256 = add v31 v3;
    v33.i256 = add v32 v8;
    v34.i256 = add v33 v9;
    v35.i256 = add v34 v6;
    v36.i256 = add v35 v12;
    v37.i256 = add v36 v4;
    v38.i256 = add v37 v13;
    v39.i256 = add v38 v2;
    return v39;
}

object @Contract {
    section runtime {
        entry %entry;
    }
}
