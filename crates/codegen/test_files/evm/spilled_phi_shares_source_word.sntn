#! evm.config: { opt: 0, stack_reach: 4, vcode: true }
#! evm.case: zero
#!   calldata: u256(0)
#!   expect: return u256(20)
#! evm.case: one
#!   calldata: u256(1)
#!   expect: return u256(2)
#! evm.case: three
#!   calldata: u256(3)
#!   expect: return u256(6)

# Twenty spilled phis take values defined before the loop. Each source dies on
# the entry edge, so its phi shares the source's word, and the edge would reload
# the word only to store it back. The deepest sources are reloaded; their pairs
# are dropped.

target = "evm-ethereum-osaka"

func private %rotate(v0.i256) -> i256 {
block0:
    v31.i256 = add v0 1.i256;
    v32.i256 = add v0 2.i256;
    v33.i256 = add v0 3.i256;
    v34.i256 = add v0 4.i256;
    v35.i256 = add v0 5.i256;
    v36.i256 = add v0 6.i256;
    v37.i256 = add v0 7.i256;
    v38.i256 = add v0 8.i256;
    v39.i256 = add v0 9.i256;
    v40.i256 = add v0 10.i256;
    v41.i256 = add v0 11.i256;
    v42.i256 = add v0 12.i256;
    v43.i256 = add v0 13.i256;
    v44.i256 = add v0 14.i256;
    v45.i256 = add v0 15.i256;
    v46.i256 = add v0 16.i256;
    v47.i256 = add v0 17.i256;
    v48.i256 = add v0 18.i256;
    v49.i256 = add v0 19.i256;
    v50.i256 = add v0 20.i256;
    jump block1;

block1:
    v1.i256 = phi (v31 block0) (v2 block2);
    v2.i256 = phi (v32 block0) (v3 block2);
    v3.i256 = phi (v33 block0) (v4 block2);
    v4.i256 = phi (v34 block0) (v5 block2);
    v5.i256 = phi (v35 block0) (v6 block2);
    v6.i256 = phi (v36 block0) (v7 block2);
    v7.i256 = phi (v37 block0) (v8 block2);
    v8.i256 = phi (v38 block0) (v9 block2);
    v9.i256 = phi (v39 block0) (v10 block2);
    v10.i256 = phi (v40 block0) (v11 block2);
    v11.i256 = phi (v41 block0) (v12 block2);
    v12.i256 = phi (v42 block0) (v13 block2);
    v13.i256 = phi (v43 block0) (v14 block2);
    v14.i256 = phi (v44 block0) (v15 block2);
    v15.i256 = phi (v45 block0) (v16 block2);
    v16.i256 = phi (v46 block0) (v17 block2);
    v17.i256 = phi (v47 block0) (v18 block2);
    v18.i256 = phi (v48 block0) (v19 block2);
    v19.i256 = phi (v49 block0) (v20 block2);
    v20.i256 = phi (v50 block0) (v1 block2);
    v21.i256 = phi (0.i256 block0) (v22 block2);
    v23.i1 = lt v21 v0;
    br v23 block2 block3;

block2:
    v22.i256 = add v21 1.i256;
    jump block1;

block3:
    return v20;
}

func public %entry() {
block0:
    v0.i256 = evm_calldata_load 0.i256;
    v1.i256 = call %rotate v0;
    mstore 0.i256 v1 i256;
    evm_return 0.i256 32.i256;
}

object @Contract { section runtime { entry %entry; } }
