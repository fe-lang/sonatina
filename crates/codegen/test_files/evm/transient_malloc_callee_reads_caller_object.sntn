#! evm.config: { vcode: true, opt: 0 }
#! evm.case: ok
#!   calldata:
#!   expect: return u256(7)

target = "evm-ethereum-osaka"

# `%copy` reads through an argument. IR reaches the free-pointer slot only
# through immediate addresses, so `%copy` cannot read the free pointer and
# `%f`'s buffer stays transient: it never advances the free pointer.

func public %entry() {
    block0:
        v0.*i256 = evm_malloc 32.i256;
        mstore v0 7.i256 i256;
        v1.i256 = call %f v0;
        mstore 0.i32 v1 i256;
        evm_return 0.i8 32.i8;
}

func private %f(v0.*i256) -> i256 {
    block0:
        v1.*i256 = evm_malloc 32.i256;
        call %copy v1 v0;
        v2.i256 = mload v1 i256;
        return v2;
}

func private %copy(v0.*i256, v1.*i256) {
    block0:
        v2.i256 = mload v1 i256;
        mstore v0 v2 i256;
        return;
}

object @Contract {
  section runtime {
    entry %entry;
  }
}
