type @Pair = {[i256; 2], @E};
type @E = enum {
    #None,
    #A,
};

func public %entry() {
    block0:
        v1.objref<@Pair> = obj.alloc @Pair;
        v3.objref<[i256; 2]> = obj.proj v1 0.i256;
        v4.objref<i256> = obj.index v3 0.i256;
        obj.store v4 5.i256;
        v7.objref<i256> = obj.index v3 1.i256;
        obj.store v7 9.i256;
        v9.objref<@E> = obj.proj v1 1.i256;
        enum.set_tag v9 #None;
        v11.@Pair = obj.load v1;
        v13.@E = extract_value v11 1.i256;
        v14.enumtag(@E) = enum.tag v13;
        br_table v14 block11 (0.enumtag(@E) block12) (1.enumtag(@E) block10);

    block10:
        jump block12;

    block11:
        unreachable;

    block12:
        v23.i1 = phi (1.i1 block0) (0.i1 block10);
        v12.[i256; 2] = extract_value v11 0.i256;
        v18.i256 = extract_value v12 0.i256;
        br v23 block13 block15;

    block13:
        v20.i1 = eq v18 5.i256;
        br v20 block1 block15;

    block15:
        evm_revert 0.i256 0.i256;

    block1:
        evm_return 0.i8 0.i8;
}


