#! evm.config: { opt: 0 }
#! evm.case: field
#!   calldata: u256(256) u256(2)
#!   expect: return u256(0) u256(0)

target = "evm-ethereum-osaka"

type @S = { i8 };
type @B = { i1 };

# Storing `undef.@S` and `undef.@B` stores nothing, so the words at 4096 and
# 4128 still hold 256 and 2, and the members read back hold the unspecified
# value. Freezing the `i8` masks its word, so its `zext` is below 256; the `i1`
# member reads as the low bit of its word, so its `zext` is below 2.
func public %entry() {
    block0:
        v0.i256 = evm_calldata_load 0.i32;
        v1.i256 = evm_calldata_load 32.i32;
        mstore 4096.i32 v0 i256;
        mstore 4128.i32 v1 i256;
        mstore 4096.i32 undef.@S @S;
        mstore 4128.i32 undef.@B @B;
        v2.@S = mload 4096.i32 @S;
        v3.i8 = extract_value v2 0.i8;
        v4.i8 = freeze v3;
        v5.i256 = zext v4 i256;
        v6.@B = mload 4128.i32 @B;
        v7.i1 = extract_value v6 0.i8;
        v8.i1 = freeze v7;
        v9.i256 = zext v8 i256;
        mstore 0.i32 v5 i256;
        mstore 32.i32 v9 i256;
        evm_return 0.i32 64.i32;
}

object @Contract {
  section runtime {
    entry %entry;
  }
}
