#! evm.config: { vcode: true, opt: 0 }
#! evm.case: fields
#!   calldata: u256(7) u256(9)
#!   expect: return u256(7) u256(9)

target = "evm-ethereum-osaka"

type @pair = { i256, i256 };

# Copying an `undef` aggregate into memory stores nothing: the slot keeps what
# it held, which is one of the values `undef` allows. The first insert stores
# only its own field, and the store of `undef.@pair` stores nothing.
func public %entry() {
    block0:
        v0.i256 = evm_calldata_load 0.i32;
        v1.i256 = evm_calldata_load 32.i32;
        v2.@pair = insert_value undef.@pair 0.i8 v0;
        v3.@pair = insert_value v2 1.i8 v1;
        mstore 64.i32 undef.@pair @pair;
        v4.i256 = extract_value v3 0.i8;
        v5.i256 = extract_value v3 1.i8;
        mstore 0.i32 v4 i256;
        mstore 32.i32 v5 i256;
        evm_return 0.i32 64.i32;
}

object @Contract {
  section runtime {
    entry %entry;
  }
}
