#! evm.config: { vcode: true, opt: 2, stackify_trace: false }
#! evm.case: input_0
#!   calldata: u256(0)
#!   expect: return u256(0)
#! evm.case: input_1
#!   calldata: u256(1)
#!   expect: return u256(0)
#! evm.case: input_9
#!   calldata: u256(9)
#!   expect: return u256(0)
#! evm.case: input_10
#!   calldata: u256(10)
#!   expect: return u256(1)
#! evm.case: input_11
#!   calldata: u256(11)
#!   expect: return u256(1)
#! evm.case: input_255
#!   calldata: u256(255)
#!   expect: return u256(1)
#! evm.case: input_256
#!   calldata: u256(256)
#!   expect: return u256(1)
#! evm.case: input_115792089237316195423570985008687907853269984665640564039457584007913129639935
#!   calldata: u256(115792089237316195423570985008687907853269984665640564039457584007913129639935)
#!   expect: return u256(1)

target = "evm-ethereum-osaka"
func public %entry() {
block0:
 v0.i256 = evm_calldata_load 0.i256;
 v1.i256 = evm_udiv v0 10.i256;
 v2.i1 = ne v1 0.i256;
 v3.i256 = zext v2 i256;
 mstore 0.i256 v3 i256;
 evm_return 0.i256 32.i256;
}
object @Contract {
 section runtime { entry %entry; }
}
