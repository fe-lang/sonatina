// func private %leanimt_root_from_calldata(v0.i256, v1.i256, v2.i256, v3.i256) -> i256
leanimt_root_from_calldata:
  block0:
    JUMPDEST
    PUSH1 0x20 (32)  // v19.i256 = gt v2 v18;
    DUP4
    GT
    ISZERO  // br v19 block1 block2;
    PUSH1 block2
    JUMPI
  block1:
    PUSH0  // evm_revert v56 v56;
    PUSH0
    REVERT
  block2:
    JUMPDEST
    DUP3  // br v2 block12 block13;
    ISZERO
    PUSH1 block13
    JUMPI
  block12:
    PUSH0  // jump block5;
    SWAP3
    SWAP4
    SWAP2
    SWAP1
  block5:
    JUMPDEST
    DUP3  // v25.i256 = evm_calldata_load v41;
    CALLDATALOAD
    DUP3  // v44.i256 = and v53 v43;
    PUSH1 0x1 (1)
    AND
    PUSH1 0x1 (1)  // v33.i256 = eq v44 v53;
    EQ
    ISZERO  // br v33 block9 block11;
    PUSH1 block11
    JUMPI
  block9:
    PUSH0  // evm_mstore v56 v25;
    MSTORE
    PUSH1 0x20 (32)  // evm_mstore v18 v6;
    MSTORE
    PUSH1 0x40 (64)  // v26.i256 = evm_keccak256 v56 v55;
    PUSH0
    KECCAK256
    PUSH1 block10  // jump block10;
    JUMP
  block11:
    JUMPDEST
    SWAP1  // evm_mstore v56 v6;
    PUSH0
    MSTORE
    PUSH1 0x20 (32)  // evm_mstore v18 v25;
    MSTORE
    PUSH1 0x40 (64)  // v20.i256 = evm_keccak256 v56 v55;
    PUSH0
    KECCAK256
  block10:
    JUMPDEST
    SWAP3  // v21.i256 = add v53 v39;
    PUSH1 0x1 (1)
    ADD
    DUP5  // v22.i256 = lt v21 v2;
    DUP2
    LT
    SWAP2  // v23.i256 = shr v53 v43;
    PUSH1 0x1 (1)
    SHR
    SWAP3  // v24.i256 = add v18 v41;
    PUSH1 0x20 (32)
    ADD
    SWAP2  // br v22 block14 block15;
    ISZERO
    PUSH1 block15
    JUMPI
  block14:
    SWAP3  // jump block5;
    SWAP2
    SWAP1
    SWAP2
    PUSH1 block5
    JUMP
  block15:
    JUMPDEST
    POP  // jump block8;
    POP
    POP
    SWAP1
    POP
    PUSH1 block8
    JUMP
  block13:
    JUMPDEST
    SWAP3  // jump block8;
    POP
    POP
    POP
  block8:
    JUMPDEST
    SWAP1  // return v12;
    JUMP

// func private %smt_root_from_calldata(v0.i256, v1.i256, v2.i256, v3.i256) -> i256
smt_root_from_calldata:
  block0:
    JUMPDEST
    DUP3  // v95.i256 = eq v127 v2;
    PUSH4 0xffffffff (4294967295)
    EQ
    PUSH1 block18  // br v95 block18 block1;
    JUMPI
  block1:
    PUSH1 `pc + (3)`  // call %smt_store_zero_table;
    PUSH1 FuncRef(0)
    JUMP
    JUMPDEST
    PUSH0  // jump block10;
    SWAP4
    PUSH1 0x40 (64)
    SWAP3
  block10:
    JUMPDEST
    DUP5  // v90.i256 = and v92 v24;
    PUSH1 0x1 (1)
    AND
    PUSH1 0x1 (1)  // v88.i256 = eq v90 v92;
    EQ
    DUP5  // v86.i256 = evm_mload v132;
    MLOAD
    SWAP1  // br v88 block12 block20;
    ISZERO
    PUSH1 block20
    JUMPI
  block12:
    POP  // v39.i256 = evm_calldata_load v19;
    DUP2
    CALLDATALOAD
    SWAP2  // v133.i256 = add v40 v19;
    PUSH1 0x20 (32)
    ADD
    SWAP2  // jump block14;
    SWAP1
    SWAP2
    PUSH1 block14
    JUMP
  block20:
    JUMPDEST
    SWAP1  // jump block14;
    SWAP2
  block14:
    JUMPDEST
    DUP3  // v45.i256 = and v92 v15;
    PUSH1 0x1 (1)
    AND
    PUSH1 0x1 (1)  // v47.i256 = eq v45 v92;
    EQ
    ISZERO  // br v47 block15 block17;
    PUSH1 block17
    JUMPI
  block15:
    SWAP1  // evm_mstore v49 v80;
    PUSH0
