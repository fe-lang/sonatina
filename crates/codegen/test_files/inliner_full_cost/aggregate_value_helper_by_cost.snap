---
source: crates/codegen/tests/inliner.rs
input_file: test_files/inliner_full_cost/aggregate_value_helper_by_cost.sntn
---
func private %view(v0.i256, v1.i1) -> @pair {
    block0:
        br v1 block1 block2;

    block1:
        v2.@pair = agg.make @pair v0 1.i256;
        return v2;

    block2:
        v3.@pair = agg.make @pair v0 2.i256;
        return v3;
}


func public %caller(v0.i256, v1.i256, v2.i1) -> i256 {
    block0:
        jump block2;

    block2:
        br v2 block3 block4;

    block3:
        v12.@pair = agg.make @pair v0 1.i256;
        jump block1;

    block4:
        v14.@pair = agg.make @pair v0 2.i256;
        jump block1;

    block1:
        v15.@pair = phi (v12 block3) (v14 block4);
        jump block6;

    block6:
        br v2 block7 block8;

    block7:
        v16.@pair = agg.make @pair v1 1.i256;
        jump block5;

    block8:
        v17.@pair = agg.make @pair v1 2.i256;
        jump block5;

    block5:
        v18.@pair = phi (v16 block7) (v17 block8);
        v5.i256 = extract_value v15 0.i8;
        v6.i256 = extract_value v18 1.i8;
        v7.i256 = add v5 v6;
        evm_sstore 0.i256 v7;
        return v7;
}
