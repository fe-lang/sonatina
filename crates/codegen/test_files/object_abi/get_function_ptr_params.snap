---
target = "evm-ethereum-osaka"

type @a = {i256, i256};
type @b = {i256, i8};
type @c = {i8, i256, i8};

func private %make_a(v4.objref<@a>, v0.i256) {
    block0:
        v2.objref<i256> = obj.proj v4 0.i8;
        obj.store v2 v0;
        return;
}

func private %make_b(v4.objref<@b>, v0.i256) {
    block0:
        v2.objref<i256> = obj.proj v4 0.i8;
        obj.store v2 v0;
        return;
}

func private %make_c(v4.objref<@c>, v0.i256) {
    block0:
        v2.objref<i256> = obj.proj v4 1.i8;
        obj.store v2 v0;
        return;
}

func private %use_a(v0.*(objref<@a>, i256) -> unit) -> i256 {
    block0:
        v1.i256 = ptr_to_int v0 i256;
        return v1;
}

func private %use_b(v0.*(objref<@b>, i256) -> unit) -> i256 {
    block0:
        v1.i256 = ptr_to_int v0 i256;
        return v1;
}

func private %use_c(v0.*(objref<@c>, i256) -> unit) -> i256 {
    block0:
        v1.i256 = ptr_to_int v0 i256;
        return v1;
}

func public %take_makers() -> i256 {
    block0:
        v0.*(objref<@a>, i256) -> unit = get_function_ptr %make_a;
        v1.*(objref<@b>, i256) -> unit = get_function_ptr %make_b;
        v2.*(objref<@c>, i256) -> unit = get_function_ptr %make_c;
        v3.i256 = call %use_a v0;
        v4.i256 = call %use_b v1;
        v5.i256 = call %use_c v2;
        v6.i256 = add v3 v4;
        v7.i256 = add v6 v5;
        return v7;
}
