target = "evm-ethereum-osaka"

type @node = {i256, *@node};

func public %next_value(v0.*@node) -> i256 {
    block0:
        v1.**@node = gep v0 0.i64 1.i8;
        v2.*@node = mload v1 *@node;
        v3.*i256 = gep v2 0.i64 0.i8;
        v4.i256 = mload v3 i256;
        return v4;
}
