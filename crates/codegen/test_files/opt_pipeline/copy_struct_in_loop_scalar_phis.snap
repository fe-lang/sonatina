---
source: crates/codegen/tests/opt_pipeline.rs
input_file: test_files/opt_pipeline/copy_struct_in_loop_scalar_phis.sntn
---
target = "evm-ethereum-osaka"

type @pair = {i256, i256};

func public %copy_in_loop(v0.i256) -> i256 {
    block0:
        jump block1;

    block1:
        v33.i256 = phi (0.i256 block0) (v11 block2);
        v23.i256 = phi (0.i256 block0) (v33 block2);
        v8.i1 = lt v33 v0;
        br v8 block2 block3;

    block2:
        v11.i256 = add v33 1.i256;
        jump block1;

    block3:
        v17.i256 = add v23 v33;
        return v17;
}
