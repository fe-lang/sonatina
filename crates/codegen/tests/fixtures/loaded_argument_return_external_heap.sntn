target = "evm-ethereum-osaka"
func inline(never) private %recover() -> i256 {
block0:
    v0.*i256 = evm_malloc 128.i256;
    mstore v0 42.i256 i256;
    v1.*i256 = alloca i256;
    v2.i256 = ptr_to_int v0 i256;
    mstore v1 v2 i256;
    v3.*i256 = evm_malloc 32.i256;
    v4.i256 = evm_call 100000.i256 4.i256 0.i256 v1 32.i256 v3 32.i256;
    v5.i256 = mload v3 i256;
    return v5;
}
func inline(never) private %touch(v0.*i256) -> i256 {
block0:
    v1.i256 = mload v0 i256;
    return v1;
}
func public %entry() {
block0:
    v0.i256 = call %recover;
    v1.*i256 = evm_malloc 128.i256;
    mstore v1 99.i256 i256;
    v2.i256 = call %touch v1;
    v3.i256 = mload v0 i256;
    mstore 0.i256 v3 i256;
    mstore 32.i256 v2 i256;
    evm_return 0.i256 64.i256;
}
object @Contract { section runtime { entry %entry; } }
