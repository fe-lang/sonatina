target = "evm-ethereum-osaka"
func inline(never) private %recover(v0.*i256) -> i256 {
block0:
    v1.i256 = mload v0 i256;
    v2.i256 = mload v1 i256;
    v3.i256 = mload v2 i256;
    return v3;
}
func inline(never) private %touch(v0.*i256) -> i256 {
block0:
    v1.*i256 = evm_malloc 128.i256;
    mstore v1 77.i256 i256;
    v2.i256 = mload v0 i256;
    return v2;
}
func public %entry() {
block0:
    v0.*i256 = evm_malloc 128.i256;
    v1.*i256 = bitcast v0 *i256;
    mstore v1 42.i256 i256;
    v2.*[i256; 2] = alloca [i256; 2];
    v3.*i256 = bitcast v2 *i256;
    v4.i256 = ptr_to_int v1 i256;
    mstore v3 v4 i256;
    v5.*i256 = evm_malloc 32.i256;
    v6.i256 = ptr_to_int v3 i256;
    mstore v5 v6 i256;
    v7.*i256 = gep v2 0.i256 1.i256;
    v8.i256 = ptr_to_int v5 i256;
    mstore v7 v8 i256;
    v9.*i256 = evm_malloc 128.i256;
    mstore v9 99.i256 i256;
    v10.i256 = call %touch v9;
    v11.i256 = call %recover v5;
    mstore 0.i256 v11 i256;
    mstore 32.i256 v10 i256;
    evm_return 0.i256 64.i256;
}
object @Contract { section runtime { entry %entry; } }
