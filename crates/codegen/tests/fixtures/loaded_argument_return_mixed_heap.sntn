target = "evm-ethereum-osaka"
func inline(never) private %recover(v0.*i256, v1.i1) -> i256 {
block0:
    br v1 block1 block2;
block1:
    v2.*i256 = evm_malloc 32.i256;
    v3.i256 = ptr_to_int v2 i256;
    return v3;
block2:
    v4.i256 = mload v0 i256;
    return v4;
}
func inline(never) private %touch(v0.*i256) -> i256 {
block0:
    v1.i256 = mload v0 i256;
    return v1;
}
func public %entry() {
block0:
    v0.*[i256; 4] = alloca [i256; 4];
    v1.*i256 = bitcast v0 *i256;
    mstore v1 42.i256 i256;
    v2.*i256 = alloca i256;
    v3.i256 = ptr_to_int v1 i256;
    mstore v2 v3 i256;
    v4.i256 = evm_calldata_load 0.i256;
    v5.i1 = eq v4 1.i256;
    v6.i256 = call %recover v2 v5;
    v7.*i256 = alloca i256;
    mstore v7 v6 i256;
    v8.*[i256; 4] = alloca [i256; 4];
    v9.*i256 = bitcast v8 *i256;
    mstore v9 99.i256 i256;
    v10.i256 = call %touch v9;
    v11.i256 = mload v7 i256;
    v12.i256 = mload v11 i256;
    mstore 0.i256 v12 i256;
    mstore 32.i256 v10 i256;
    evm_return 0.i256 64.i256;
}
object @Contract { section runtime { entry %entry; } }
