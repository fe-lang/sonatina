target = "evm-ethereum-osaka"
func inline(never) private %recover(v0.*i256) -> i256 {
block0:
    v2.i256 = ptr_to_int v0 i256;
    v3.i256 = add v2 32.i256;
    v1.i256 = mload v3 i256;
    return v1;
}
func inline(never) private %wrapped(v0.*i256) -> i256 {
block0:
