target = "evm-ethereum-osaka"
type @Pair = { i256, i256 };
func inline(never) private %recover(v0.*@Pair) -> i256 {
block0:
    v1.@Pair = mload v0 @Pair;
    v2.i256 = extract_value v1 1.i8;
    return v2;
}
func inline(never) private %touch(v0.*i256) -> i256 {
block0:
    v1.i256 = mload v0 i256;
    return v1;
}
func public %entry() {
block0:
    v0.*[i256; 4] = alloca [i256; 4];
    v1.*i256 = bitcast v0 *i256;
    mstore v1 42.i256 i256;
    v2.*@Pair = alloca @Pair;
    v3.*i256 = gep v2 0.i256 1.i256;
    v4.i256 = ptr_to_int v1 i256;
    mstore v3 v4 i256;
    v5.i256 = call %recover v2;
    v6.*[i256; 4] = alloca [i256; 4];
    v7.*i256 = bitcast v6 *i256;
    mstore v7 99.i256 i256;
    v8.i256 = call %touch v7;
    v9.i256 = mload v5 i256;
    mstore 0.i256 v9 i256;
    mstore 32.i256 v8 i256;
    evm_return 0.i256 64.i256;
}
object @Contract { section runtime { entry %entry; } }
