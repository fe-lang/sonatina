#! `v0` is 1, so `ne v0 0` always holds and the loop never exits. ADCE removes
#! the dead instructions and the empty `block1` but keeps the cycle through
#! the latch `block2`.

target = "evm-ethereum-london"

# sameln: func public %divergent_loop_dead_body_removed() -> i8 {
# nextln:    block0:
# nextln:        v0.i8 = or 1.i8 0.i8;
# nextln:        v4.i1 = ne v0 0.i8;
# nextln:        br v4 block2 block3;
# nextln:
# nextln:    block2:
# nextln:        jump block0;
# nextln:
# nextln:    block3:
# nextln:        return v0;
func public %divergent_loop_dead_body_removed() -> i8 {
    block0:
        v0.i8 = or 1.i8 0.i8;
        v4.i1 = ne v0 0.i8;
        br v4 block1 block3;

    block1:
        v1.i8 = add v0 1.i8;
        jump block2;

    block2:
        v2.i8 = add v0 2.i8;
        v3.i8 = add v0 v0;
        jump block0;

    block3:
        return v0;
}
