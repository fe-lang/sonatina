target = "evm-ethereum-london"

type @slice = { i256, i256 };
type @outer = { @slice, i256 };

# sameln: func public %extract_field(v0.i256, v1.i256) -> i256 {
# check:     block0:
# check:         return v1;
func public %extract_field(v0.i256, v1.i256) -> i256 {
    block0:
        v2.@slice = agg.make @slice v0 v1;
        v3.i256 = extract_value v2 1.i8;
        return v3;
}

# sameln: func public %extract_past_insert(v0.i256, v1.i256, v2.i256) -> i256 {
# check:     block0:
# check:         return v0;
func public %extract_past_insert(v0.i256, v1.i256, v2.i256) -> i256 {
    block0:
        v3.@slice = agg.make @slice v0 v1;
        v4.@slice = insert_value v3 1.i8 v2;
        v5.i256 = extract_value v4 0.i8;
        return v5;
}

# sameln: func public %extract_nested(v0.i256, v1.i256, v2.i256) -> i256 {
# check:     block0:
# check:         return v1;
func public %extract_nested(v0.i256, v1.i256, v2.i256) -> i256 {
    block0:
        v3.@slice = agg.make @slice v0 v1;
        v4.@outer = agg.make @outer v3 v2;
        v5.@slice = extract_value v4 0.i8;
        v6.i256 = extract_value v5 1.i8;
        return v6;
}

# sameln: func public %insert_into_made(v0.i256, v1.i256, v2.i256) -> @slice {
# check:     block0:
# check:         v4.@slice = agg.make @slice v0 v2;
# check:         return v4;
func public %insert_into_made(v0.i256, v1.i256, v2.i256) -> @slice {
    block0:
        v3.@slice = agg.make @slice v0 v1;
        v4.@slice = insert_value v3 1.i8 v2;
        return v4;
}

# sameln: func public %rebuilt(v0.@outer) -> @outer {
# check:     block0:
# check:         return v0;
func public %rebuilt(v0.@outer) -> @outer {
    block0:
        v1.@slice = extract_value v0 0.i8;
        v2.i256 = extract_value v1 0.i8;
        v3.i256 = extract_value v1 1.i8;
        v4.@slice = agg.make @slice v2 v3;
        v5.i256 = extract_value v0 1.i8;
        v6.@outer = agg.make @outer v4 v5;
        return v6;
}

# A field from elsewhere rebuilds nothing.
# sameln: func public %not_rebuilt(v0.@slice, v1.i256) -> @slice {
# check:         v3.@slice = agg.make @slice v2 v1;
func public %not_rebuilt(v0.@slice, v1.i256) -> @slice {
    block0:
        v2.i256 = extract_value v0 0.i8;
        v3.@slice = agg.make @slice v2 v1;
        return v3;
}

# The phi of `agg.make`s becomes the `agg.make` of a phi per field, in field order.
# sameln: func public %phi_of_made(v0.i1, v1.i256, v2.i256) -> @slice {
# check:     block3:
# nextln:         v7.i256 = phi (v1 block1) (v2 block2);
# nextln:         v8.i256 = phi (v2 block1) (0.i256 block2);
# nextln:         v9.@slice = agg.make @slice v7 v8;
# nextln:         return v9;
func public %phi_of_made(v0.i1, v1.i256, v2.i256) -> @slice {
    block0:
        br v0 block1 block2;
    block1:
        v3.@slice = agg.make @slice v1 v2;
        jump block3;
    block2:
        v4.@slice = agg.make @slice v2 0.i256;
        jump block3;
    block3:
        v5.@slice = phi (v3 block1) (v4 block2);
        return v5;
}
