#! AggregateCombine should drop an assertion that an enum made of a variant is that variant once the assertion is the enum's only use; dead-code elimination then drops the enum.

target = "evm-ethereum-osaka"

type @OptionI256 = enum {
    #None,
    #Some(i256),
};

# sameln: func private %unwrap_made(v0.i256) -> i256 {
# not:     enum.assert_variant
# check:   return v0;
func private %unwrap_made(v0.i256) -> i256 {
    block0:
        v1.@OptionI256 = enum.make @OptionI256 #Some v0;
        enum.assert_variant v1 #Some;
        return v0;
}

# sameln: func private %unwrap_other(v0.i256) -> i256 {
# check:   enum.assert_variant v1 #None;
func private %unwrap_other(v0.i256) -> i256 {
    block0:
        v1.@OptionI256 = enum.make @OptionI256 #Some v0;
        enum.assert_variant v1 #None;
        return v0;
}

# sameln: func private %unwrap_extract(v0.i256) -> i256 {
# not:     enum.assert_variant
# check:   return v0;
func private %unwrap_extract(v0.i256) -> i256 {
    block0:
        v1.@OptionI256 = enum.make @OptionI256 #Some v0;
        enum.assert_variant v1 #Some;
        v2.i256 = enum.extract v1 #Some 0.i8;
        return v2;
}

# sameln: func private %unwrap_kept(v0.i256) -> @OptionI256 {
# check:   enum.assert_variant v1 #Some;
func private %unwrap_kept(v0.i256) -> @OptionI256 {
    block0:
        v1.@OptionI256 = enum.make @OptionI256 #Some v0;
        enum.assert_variant v1 #Some;
        return v1;
}
