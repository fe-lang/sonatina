target = "evm-ethereum-osaka"

type @pair = { i256, i256 };

# A private aggregate parameter and result expand to their leaves.

# regex: VALUE=\bv\d+\b
# check: func private %swap($(first=$VALUE).i256, $(second=$VALUE).i256) -> (i256, i256) {
# check: agg.make @pair $first $second;
# check: return (v2, v1);
func private %swap(v0.@pair) -> @pair {
    block0:
        v1.i256 = extract_value v0 0.i8;
        v2.i256 = extract_value v0 1.i8;
        v4.@pair = agg.make @pair v2 v1;
        return v4;
}

# regex: VALUE=\bv\d+\b
# check: func public %entry(v0.i256, v1.i256) -> i256 {
# check: ($VALUE.i256, $VALUE.i256) = call %swap v0 v1;
func public %entry(v0.i256, v1.i256) -> i256 {
    block0:
        v3.@pair = agg.make @pair v0 v1;
        v4.@pair = call %swap v3;
        v5.i256 = extract_value v4 0.i8;
        return v5;
}
