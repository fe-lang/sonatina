target = "evm-ethereum-osaka"

# Scalar `unit` parameters and results expand to no operand. The other
# arguments keep their order and are what the body reads: swapping them would
# change the `sub`.

# check: func private %pick(v1.i256, v3.i256) -> i256 {
# nextln:     block0:
# nextln:         v4.i256 = sub v1 v3;
# nextln:         return v4;
# nextln: }
func private %pick(v0.unit, v1.i256, v2.unit, v3.i256) -> (unit, i256) {
    block0:
        v4.i256 = sub v1 v3;
        return (v2, v4);
}

# check: func private %only_unit() -> i256 {
# nextln:     block0:
# nextln:         return 7.i256;
func private %only_unit(v0.unit) -> i256 {
    block0:
        return 7.i256;
}

# regex: VALUE=\bv\d+\b
# check: func public %entry(v0.i256, v1.i256) -> i256 {
# nextln:     block0:
# nextln:         $(picked=$VALUE).i256 = call %pick v0 v1;
# nextln:         $(seven=$VALUE).i256 = call %only_unit;
# nextln:         v5.i256 = add $picked $seven;
# nextln:         return v5;
func public %entry(v0.i256, v1.i256) -> i256 {
    block0:
        (v2.unit, v3.i256) = call %pick zero.unit v0 zero.unit v1;
        v4.i256 = call %only_unit v2;
        v5.i256 = add v3 v4;
        return v5;
}
