target = "x86_64-unknown-native"

type @frame = {*i8, i64, i64, *i8, i64};

# A five-leaf object copied from an argument, updated per field, and passed
# on whole becomes its leaves.
# regex: VALUE=\bv\d+\b
# sameln: func private %scalarize_five_leaf_object(v0.@frame) -> i64 {
# check:     block0:
# not:           obj.
# check:         $(pc=$VALUE).i64 = extract_value v0 1.i256;
# check:         $(gas=$VALUE).i64 = extract_value v0 2.i256;
# check:         v14.i64 = sub $gas 3.i64;
# check:         v15.i64 = add $pc 1.i64;
# check:         $(set_pc=$VALUE).@frame = insert_value $(base_pc=$VALUE) 1.i256 v15;
# nextln:        $(set_gas=$VALUE).@frame = insert_value $set_pc 2.i256 v14;
# check:         $(frame=$VALUE).@frame = insert_value $(rest=$VALUE) 4.i256 $(depth=$VALUE);
# nextln:        v9.i64 = call %use $frame;
func private %scalarize_five_leaf_object(v0.@frame) -> i64 {
    block0:
        v3.objref<@frame> = obj.alloc @frame;
        obj.store v3 v0;
        v4.objref<i64> = obj.proj v3 2.i8;
        v5.i64 = obj.load v4;
        v14.i64 = sub v5 3.i64;
        obj.store v4 v14;
        v6.objref<i64> = obj.proj v3 1.i8;
        v7.i64 = obj.load v6;
        v15.i64 = add v7 1.i64;
        obj.store v6 v15;
        v8.@frame = obj.load v3;
        v9.i64 = call %use v8;
        return v9;
}

func private %use(v0.@frame) -> i64 {
    block0:
        v1.i64 = extract_value v0 1.i8;
        return v1;
}
