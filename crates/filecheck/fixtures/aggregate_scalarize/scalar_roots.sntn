target = "evm-ethereum-osaka"

# sameln: func public %scalar_diamond(v0.i1, v1.i256, v2.i256) -> i256 {
# not: obj.
# check: phi (v1 block0) (v2 block2);
# not: obj.
# check: return
func public %scalar_diamond(v0.i1, v1.i256, v2.i256) -> i256 {
    block0:
        v3.objref<i256> = obj.alloc i256;
        br v0 block1 block2;
    block1:
        obj.store v3 v1;
        jump block3;
    block2:
        obj.store v3 v2;
        jump block3;
    block3:
        v4.i256 = obj.load v3;
        return v4;
}
