#! A count is at most the width, so the bit length `width - clz` and the next count cannot overflow.

target = "evm-ethereum-osaka"

# check: func public %bit_length(v0.i64) -> i64 {
# check: sub 64.i64 v1;
# not: usubo
# not: 99.i64
func public %bit_length(v0.i64) -> i64 {
block0:
    v1.i64 = clz v0;
    (v2.i64, v3.i1) = usubo 64.i64 v1;
    br v3 block1 block2;

block1:
    return 99.i64;

block2:
    return v2;
}

# check: func public %past_the_lowest_bit(v0.i8) -> i8 {
# check: add v1 1.i8;
# not: uaddo
# not: 99.i8
func public %past_the_lowest_bit(v0.i8) -> i8 {
block0:
    v1.i8 = ctz v0;
    (v2.i8, v3.i1) = uaddo v1 1.i8;
    br v3 block1 block2;

block1:
    return 99.i8;

block2:
    return v2;
}
