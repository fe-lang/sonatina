#! Masks, shifts, quotients and remainders bound their results, so later checked ops can drop their overflow checks.

target = "evm-ethereum-osaka"

# check: func public %mask_then_scale(v0.i64) -> i64 {
# check: mul v1 8.i64;
# not: umulo
# not: 99.i64
func public %mask_then_scale(v0.i64) -> i64 {
block0:
    v1.i64 = and v0 7.i64;
    (v2.i64, v3.i1) = umulo v1 8.i64;
    br v3 block1 block2;

block1:
    return 99.i64;

block2:
    return v2;
}

# check: func public %shifted_then_doubled(v0.i64) -> i64 {
# check: add v1 v1;
# not: uaddo
# not: 99.i64
func public %shifted_then_doubled(v0.i64) -> i64 {
block0:
    v1.i64 = shr 3.i64 v0;
    (v2.i64, v3.i1) = uaddo v1 v1;
    br v3 block1 block2;

block1:
    return 99.i64;

block2:
    return v2;
}

# check: func public %byte_shifted_then_squared(v0.i64) -> i64 {
# check: mul v2 v2;
# not: umulo
# not: 99.i64
func public %byte_shifted_then_squared(v0.i64) -> i64 {
block0:
    v1.i64 = and v0 255.i64;
    v2.i64 = shl 8.i64 v1;
    (v3.i64, v4.i1) = umulo v2 v2;
    br v4 block1 block2;

block1:
    return 99.i64;

block2:
    return v3;
}

# check: func public %quotient_and_remainder_scaled(v0.i64) -> i64 {
# not: umulo
# not: uaddo
# not: 99.i64
func public %quotient_and_remainder_scaled(v0.i64) -> i64 {
block0:
    v1.i64 = evm_udiv v0 1000000.i64;
    (v2.i64, v3.i1) = umulo v1 1000.i64;
    br v3 block1 block2;

block1:
    return 99.i64;

block2:
    v4.i64 = evm_umod v0 10.i64;
    (v5.i64, v6.i1) = uaddo v2 v4;
    br v6 block1 block3;

block3:
    return v5;
}

# check: func public %wide_shift_keeps_check(v0.i64) -> i64 {
# check: umulo
func public %wide_shift_keeps_check(v0.i64) -> i64 {
block0:
    v1.i64 = and v0 255.i64;
    v2.i64 = shl 60.i64 v1;
    (v3.i64, v4.i1) = umulo v2 2.i64;
    br v4 block1 block2;

block1:
    return 99.i64;

block2:
    return v3;
}

# check: func public %or_keeps_check(v0.i64) -> i64 {
# check: umulo
func public %or_keeps_check(v0.i64) -> i64 {
block0:
    v1.i64 = or v0 7.i64;
    (v2.i64, v3.i1) = umulo v1 8.i64;
    br v3 block1 block2;

block1:
    return 99.i64;

block2:
    return v2;
}
