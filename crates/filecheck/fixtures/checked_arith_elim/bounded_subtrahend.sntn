#! A remainder is at most its dividend, and an `and` is at most either
#! operand, so subtracting one from that operand cannot wrap. The divisor
#! bounds a remainder only when it is nonzero, so it guards nothing.

target = "evm-ethereum-osaka"

# check: func public %dividend_minus_remainder(v0.i64) -> i64 {
# check: sub v0 v1;
# not: usubo
# not: 999.i64
func public %dividend_minus_remainder(v0.i64) -> i64 {
block0:
    v1.i64 = umod v0 1000000000.i64;
    (v2.i64, v3.i1) = usubo v0 v1;
    br v3 block1 block2;
block1:
    return 999.i64;
block2:
    return v2;
}

# check: func public %evm_dividend_minus_remainder(v0.i256, v1.i256) -> i256 {
# check: sub v0 v2;
# not: usubo
func public %evm_dividend_minus_remainder(v0.i256, v1.i256) -> i256 {
block0:
    v2.i256 = evm_umod v0 v1;
    (v3.i256, v4.i1) = usubo v0 v2;
    br v4 block1 block2;
block1:
    return 999.i256;
block2:
    return v3;
}

# check: func public %value_minus_masked_bits(v0.i64) -> i64 {
# check: sub v0 v1;
# not: usubo
func public %value_minus_masked_bits(v0.i64) -> i64 {
block0:
    v1.i64 = and v0 7.i64;
    (v2.i64, v3.i1) = usubo v0 v1;
    br v3 block1 block2;
block1:
    return 999.i64;
block2:
    return v2;
}

# check: func public %mask_minus_masked_bits(v0.i64, v1.i64) -> i64 {
# check: sub v1 v2;
# not: usubo
func public %mask_minus_masked_bits(v0.i64, v1.i64) -> i64 {
block0:
    v2.i64 = and v0 v1;
    (v3.i64, v4.i1) = usubo v1 v2;
    br v4 block1 block2;
block1:
    return 999.i64;
block2:
    return v3;
}

# check: func public %divisor_minus_remainder_may_wrap(v0.i64, v1.i64) -> i1 {
# check: usubo v1 v2;
func public %divisor_minus_remainder_may_wrap(v0.i64, v1.i64) -> i1 {
block0:
    v2.i64 = umod v0 v1;
    (v3.i64, v4.i1) = usubo v1 v2;
    return v4;
}

# check: func public %unrelated_remainders_may_wrap(v0.i64, v1.i64) -> i1 {
# check: usubo v2 v0;
# check: usubo v0 v5;
func public %unrelated_remainders_may_wrap(v0.i64, v1.i64) -> i1 {
block0:
    v2.i64 = umod v0 v1;
    (v3.i64, v4.i1) = usubo v2 v0;
    v5.i64 = umod v1 1000.i64;
    (v6.i64, v7.i1) = usubo v0 v5;
    v8.i1 = or v4 v7;
    return v8;
}

# check: func public %signed_remainders_may_wrap(v0.i64, v1.i256, v2.i256) -> i1 {
# check: usubo v0 v3;
# check: usubo v1 v6;
func public %signed_remainders_may_wrap(v0.i64, v1.i256, v2.i256) -> i1 {
block0:
    v3.i64 = smod v0 1000.i64;
    (v4.i64, v5.i1) = usubo v0 v3;
    v6.i256 = evm_smod v1 v2;
    (v7.i256, v8.i1) = usubo v1 v6;
    v9.i1 = or v5 v8;
    return v9;
}

# check: func public %signed_subtraction_of_a_mask_may_overflow(v0.i64) -> i1 {
# check: ssubo v0 v1;
# check: ssubo v0 v4;
func public %signed_subtraction_of_a_mask_may_overflow(v0.i64) -> i1 {
block0:
    v1.i64 = and v0 7.i64;
    (v2.i64, v3.i1) = ssubo v0 v1;
    v4.i64 = umod v0 1000.i64;
    (v5.i64, v6.i1) = ssubo v0 v4;
    v7.i1 = or v3 v6;
    return v7;
}
