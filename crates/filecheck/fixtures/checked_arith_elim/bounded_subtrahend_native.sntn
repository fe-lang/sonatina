#! A native remainder is at most its dividend too.

target = "x86_64-unknown-native"

# check: func public %dividend_minus_remainder(v0.i64) -> i64 {
# check: sub v0 v1;
# not: usubo
# not: 999.i64
func public %dividend_minus_remainder(v0.i64) -> i64 {
block0:
    v1.i64 = umod v0 1000000000.i64;
    (v2.i64, v3.i1) = usubo v0 v1;
    br v3 block1 block2;
block1:
    return 999.i64;
block2:
    return v2;
}
