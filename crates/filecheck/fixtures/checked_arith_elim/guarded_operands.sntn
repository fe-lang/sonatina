#! A guard on an operand holds for the subtraction it guards, whatever the operand is computed from.

target = "evm-ethereum-osaka"

# check: func public %loaded_operand(v0.*i64) -> i64 {
# check: v2.i1 = gt 20.i64 v1;
# check: sub 20.i64 v1;
# not: usubo
# not: 99.i64
func public %loaded_operand(v0.*i64) -> i64 {
block0:
    v1.i64 = mload v0 i64;
    v2.i1 = gt 20.i64 v1;
    br v2 block1 block2;

block1:
    (v3.i64, v4.i1) = usubo 20.i64 v1;
    br v4 block3 block4;

block3:
    return 99.i64;

block4:
    return v3;

block2:
    return 0.i64;
}

# check: func public %computed_operand(v0.*i64) -> i64 {
# check: v3.i1 = gt 20.i64 v2;
# check: sub 20.i64 v2;
# not: usubo
# not: 99.i64
func public %computed_operand(v0.*i64) -> i64 {
block0:
    v1.i64 = mload v0 i64;
    v2.i64 = mul v1 3.i64;
    v3.i1 = gt 20.i64 v2;
    br v3 block1 block2;

block1:
    (v4.i64, v5.i1) = usubo 20.i64 v2;
    br v5 block3 block4;

block3:
    return 99.i64;

block4:
    return v4;

block2:
    return 0.i64;
}
