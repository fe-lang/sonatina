target = "evm-ethereum-osaka"

# Unit phis go, including ones that only take each other on a backedge.

# check: func public %loop_phi(v0.i256) -> i256 {
# nextln:     block0:
# nextln:         jump block1;
# nextln:
# nextln:     block1:
# nextln:         v3.i256 = phi (0.i256 block0) (v4 block1);
# nextln:         v4.i256 = add v3 1.i256;
# nextln:         v5.i1 = lt v4 v0;
# nextln:         br v5 block1 block2;
func public %loop_phi(v0.i256) -> i256 {
    block0:
        jump block1;

    block1:
        v1.unit = phi (undef.unit block0) (v2 block1);
        v2.unit = phi (undef.unit block0) (v1 block1);
        v3.i256 = phi (0.i256 block0) (v4 block1);
        v4.i256 = add v3 1.i256;
        v5.i1 = lt v4 v0;
        br v5 block1 block2;

    block2:
        return v4;
}

# Unit loads and stores go. A use of an erased result that stays reads
# `undef.unit`.

# check: func public %memory(v0.i256) -> i256 {
# nextln:     block0:
# nextln:         call %sink undef.unit;
# nextln:         v2.i256 = mload v0 i256;
# nextln:         return v2;
func public %memory(v0.i256) -> i256 {
    block0:
        mstore v0 undef.unit unit;
        v1.unit = mload v0 unit;
        call %sink v1;
        mstore v0 v1 unit;
        v2.i256 = mload v0 i256;
        return v2;
}

# check: block3:
# nextln:         call %sink undef.unit;
# nextln:         return;
func public %phi_use(v0.i1) {
    block0:
        br v0 block1 block2;

    block1:
        jump block3;

    block2:
        jump block3;

    block3:
        v1.unit = phi (undef.unit block1) (undef.unit block2);
        call %sink v1;
        return;
}

# A function without unit phis, loads or stores is unchanged.

# check: func private %sink(v0.unit) {
# nextln:     block0:
# nextln:         return;
func private %sink(v0.unit) {
    block0:
        return;
}

# check: func public %nothing_to_erase(v0.i256) -> i256 {
# nextln:     block0:
# nextln:         mstore v0 1.i256 i256;
# nextln:         v1.i256 = mload v0 i256;
# nextln:         return v1;
func public %nothing_to_erase(v0.i256) -> i256 {
    block0:
        mstore v0 1.i256 i256;
        v1.i256 = mload v0 i256;
        return v1;
}
