#! Phi-of-ops rewrites `op(x, phi(a, b))` as `phi(op(x, a), op(x, b))` only if
#! `x` holds one value on every edge into the phi's block. A value defined in
#! the loop body is another instance on each edge, and on the backedge the phi
#! argument may be its previous one: `lt x x` there compares two iterations.

target = "evm-ethereum-osaka"

func private %next() -> i256 {
block0:
    v0.i256 = evm_sload 0.i256;
    v1.i256 = sub v0 1.i256;
    evm_sstore 0.i256 v1;
    return v0;
}

# Whether some value `%next` returns is below the one before it.
# sameln: func public %descending(v0.i256) -> i256 {
# check:      v6.i1 = lt v5 v1;
# nextln:     br v6 block5 block3;
func public %descending(v0.i256) -> i256 {
block0:
    jump block1;
block1:
    v1.i256 = phi (0.i256 block0) (v5 block3);
    v2.i256 = phi (0.i256 block0) (v7 block3);
    v3.i1 = lt v2 v0;
    br v3 block2 block4;
block2:
    v5.i256 = call %next;
    v6.i1 = lt v5 v1;
    br v6 block5 block3;
block3:
    v7.i256 = add v2 1.i256;
    jump block1;
block4:
    return 0.i256;
block5:
    return 1.i256;
}

# The overflow check of a running sum.
# sameln: func public %sum(v0.i256, v1.i256) -> i256 {
# check:      v6.i1 = lt v5 v2;
# nextln:     br v6 block5 block3;
func public %sum(v0.i256, v1.i256) -> i256 {
block0:
    jump block1;
block1:
    v2.i256 = phi (0.i256 block0) (v5 block3);
    v3.i256 = phi (0.i256 block0) (v7 block3);
    v4.i1 = lt v3 v0;
    br v4 block2 block4;
block2:
    v5.i256 = add v2 v1;
    v6.i1 = lt v5 v2;
    br v6 block5 block3;
block3:
    v7.i256 = add v3 1.i256;
    jump block1;
block4:
    return v2;
block5:
    return 999.i256;
}
