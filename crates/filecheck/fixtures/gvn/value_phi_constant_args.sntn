#! A value phi with constant arguments pushes a constant on every edge into its
#! block. Every path to an exit must consume the value, through the selected edges
#! of any nested phis and ultimately the instruction being replaced. Blocks that
#! cannot reach a CFG exit count as additional exits.

target = "evm-ethereum-london"

# regex: VALUE=\bv\d+\b
# check:  block3:
# nextln:     $(sum=$VALUE).i256 = phi (11.i256 block0) (12.i256 block2);
# nextln:     v1.i256 = phi (1.i256 block0) (2.i256 block2);
# nextln:     return $sum;
func public %at_join(v0.i1) -> i256 {
    block0:
        br v0 block1 block2;

    block1:
        jump block3;

    block2:
        jump block3;

    block3:
        v1.i256 = phi (1.i256 block1) (2.i256 block2);
        v2.i256 = add v1 10.i256;
        return v2;
}

# regex: VALUE=\bv\d+\b
# check:  block3:
# nextln:     $(sum=$VALUE).i256 = phi (11.i256 block0) (12.i256 block2);
# nextln:     v2.i256 = phi (1.i256 block0) (2.i256 block2);
# nextln:     v3.i256 = add v1 v2;
# nextln:     v5.i256 = add v3 $sum;
# nextln:     return v5;
func public %after_join_on_every_path(v0.i1, v1.i256) -> i256 {
    block0:
        br v0 block1 block2;

    block1:
        jump block3;

    block2:
        jump block3;

    block3:
        v2.i256 = phi (1.i256 block1) (2.i256 block2);
        v3.i256 = add v1 v2;
        jump block4;

    block4:
        v4.i256 = add v2 10.i256;
        v5.i256 = add v3 v4;
        return v5;
}

# check:  block3:
# nextln:     v2.i256 = phi (1.i256 block0) (2.i256 block2);
# nextln:     br v1 block4 block5;
# nextln: 
# nextln: block4:
# nextln:     v3.i256 = add v2 10.i256;
# nextln:     return v3;
func public %after_join_on_one_path(v0.i1, v1.i1) -> i256 {
    block0:
        br v0 block1 block2;

    block1:
        jump block3;

    block2:
        jump block3;

    block3:
        v2.i256 = phi (1.i256 block1) (2.i256 block2);
        br v1 block4 block5;

    block4:
        v3.i256 = add v2 10.i256;
        return v3;

    block5:
        return v2;
}

#! A branch into a closed region counts as a path that skips the use.
# check:  block3:
# nextln:     v2.i256 = phi (1.i256 block0) (2.i256 block2);
# nextln:     br v1 block4 block5;
# check:  block4:
# nextln:     v3.i256 = add v2 10.i256;
# nextln:     return v3;
func public %after_join_or_closed_loop(v0.i1, v1.i1) -> i256 {
    block0:
        br v0 block1 block2;

    block1:
        jump block3;

    block2:
        jump block3;

    block3:
        v2.i256 = phi (1.i256 block1) (2.i256 block2);
        br v1 block4 block5;

    block4:
        v3.i256 = add v2 10.i256;
        return v3;

    block5:
        evm_sstore 0.i256 v2;
        jump block5;
}

#! The virtual-exit policy also covers closed SCCs with multiple blocks.
# check:  block3:
# nextln:     v2.i256 = phi (1.i256 block0) (2.i256 block2);
# nextln:     br v1 block4 block5;
# check:  block4:
# nextln:     v3.i256 = add v2 10.i256;
# nextln:     return v3;
func public %after_join_or_closed_scc(v0.i1, v1.i1) -> i256 {
    block0:
        br v0 block1 block2;

    block1:
        jump block3;

    block2:
        jump block3;

    block3:
        v2.i256 = phi (1.i256 block1) (2.i256 block2);
        br v1 block4 block5;

    block4:
        v3.i256 = add v2 10.i256;
        return v3;

    block5:
        evm_sstore 0.i256 v2;
        jump block6;

    block6:
        evm_sstore 1.i256 v2;
        br v0 block5 block6;
}

#! An ordinary loop with an exit edge must not prevent folding after the loop.
# regex: VALUE=\bv\d+\b
# check:  block3:
# nextln:     $(sum=$VALUE).i256 = phi (11.i256 block0) (12.i256 block2);
# nextln:     v1.i256 = phi (1.i256 block0) (2.i256 block2);
# nextln:     jump block4;
# check:  block6:
# nextln:     return $sum;
func public %after_exiting_loop(v0.i1) -> i256 {
    block0:
        br v0 block1 block2;

    block1:
        jump block3;

    block2:
        jump block3;

    block3:
        v1.i256 = phi (1.i256 block1) (2.i256 block2);
        jump block4;

    block4:
        v2.i256 = phi (0.i256 block3) (v3 block5);
        v4.i1 = lt v2 10.i256;
        br v4 block5 block6;

    block5:
        evm_sstore 0.i256 v2;
        v3.i256 = add v2 1.i256;
        jump block4;

    block6:
        v5.i256 = add v1 10.i256;
        return v5;
}

#! Divergence after the instruction does not bypass its use of the constant phi.
# regex: VALUE=\bv\d+\b
# check:  block3:
# nextln:     $(sum=$VALUE).i256 = phi (11.i256 block0) (12.i256 block2);
# nextln:     v2.i256 = phi (1.i256 block0) (2.i256 block2);
# nextln:     evm_sstore 0.i256 $sum;
# nextln:     br v1 block5 block6;
# check:  block6:
# nextln:     return $sum;
func public %before_return_or_closed_loop(v0.i1, v1.i1) -> i256 {
    block0:
        br v0 block1 block2;

    block1:
        jump block3;

    block2:
        jump block3;

    block3:
        v2.i256 = phi (1.i256 block1) (2.i256 block2);
        jump block4;

    block4:
        v3.i256 = add v2 10.i256;
        evm_sstore 0.i256 v3;
        br v1 block5 block6;

    block5:
        jump block5;

    block6:
        return v3;
}

#! Reaching the outer join does not imply taking the edge that consumes the inner phi.
# check:  block3:
# nextln:     v2.i256 = phi (1.i256 block0) (2.i256 block2);
# check:  block5:
# nextln:     v3.i256 = phi (v2 block3) (3.i256 block4);
# nextln:     v4.i256 = add v3 10.i256;
# nextln:     return v4;
func public %nested_phi_on_one_edge(v0.i1, v1.i1) -> i256 {
    block0:
        br v0 block1 block2;
    block1:
        jump block3;
    block2:
        jump block3;
    block3:
        v2.i256 = phi (1.i256 block1) (2.i256 block2);
        evm_sstore 0.i256 v2;
        br v1 block5 block4;
    block4:
        evm_sstore 1.i256 v2;
        jump block5;
    block5:
        v3.i256 = phi (v2 block3) (3.i256 block4);
        v4.i256 = add v3 10.i256;
        return v4;
}

#! The same restriction applies when the consuming predecessor is a separate block.
# check:  block3:
# nextln:     v2.i256 = phi (1.i256 block0) (2.i256 block2);
# check:  block6:
# nextln:     v3.i256 = phi (v2 block4) (3.i256 block5);
# nextln:     v4.i256 = add v3 10.i256;
# nextln:     return v4;
func public %nested_phi_on_one_predecessor(v0.i1, v1.i1) -> i256 {
    block0:
        br v0 block1 block2;
    block1:
        jump block3;
    block2:
        jump block3;
    block3:
        v2.i256 = phi (1.i256 block1) (2.i256 block2);
        evm_sstore 0.i256 v2;
        br v1 block4 block5;
    block4:
        evm_sstore 1.i256 v2;
        jump block6;
    block5:
        evm_sstore 2.i256 v2;
        jump block6;
    block6:
        v3.i256 = phi (v2 block4) (3.i256 block5);
        v4.i256 = add v3 10.i256;
        return v4;
}
