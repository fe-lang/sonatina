#! An `agg.make` moves like an insert chain on undef: up to just after the last value it takes, when its result fills a field of another or is returned.

target = "evm-ethereum-osaka"

# The inner `agg.make` moves into block0 after `v2`, and the outer one, which is returned, after it.
# sameln: func private %across_blocks(v0.i64, v1.i1) -> [[i64; 2]; 2] {
# nextln: block0:
# nextln: v2.i64 = add v0 1.i64;
# nextln: v4.[i64; 2] = agg.make [i64; 2] v2 v0;
# nextln: v5.[[i64; 2]; 2] = agg.make [[i64; 2]; 2] v4 undef.[i64; 2];
# nextln: br v1 block1 block2;
func private %across_blocks(v0.i64, v1.i1) -> [[i64; 2]; 2] {
block0:
    v2.i64 = add v0 1.i64;
    br v1 block1 block2;

block1:
    jump block3;

block2:
    jump block3;

block3:
    v4.[i64; 2] = agg.make [i64; 2] v2 v0;
    v5.[[i64; 2]; 2] = agg.make [[i64; 2]; 2] v4 undef.[i64; 2];
    return v5;
}
