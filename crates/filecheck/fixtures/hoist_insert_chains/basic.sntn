#! An `agg.make` chain whose result fills a field of another chain, or is returned, moves up to just after the last value it inserts.

target = "evm-ethereum-osaka"

# The inner chain moves into block0 after `v2`, and the outer chain, which is returned, after it.
# sameln: func private %across_blocks(v0.i64, v1.i1) -> [[i64; 2]; 2] {
# nextln: block0:
# nextln: v2.i64 = add v0 1.i64;
# nextln: v4.[i64; 2] = agg.make [i64; 2] v2 v0;
# nextln: v5.[[i64; 2]; 2] = agg.make [[i64; 2]; 2] v4 zero.[i64; 2];
# nextln: br v1 block1 block2;
func private %across_blocks(v0.i64, v1.i1) -> [[i64; 2]; 2] {
block0:
    v2.i64 = add v0 1.i64;
    br v1 block1 block2;

block1:
    jump block3;

block2:
    jump block3;

block3:
    v4.[i64; 2] = agg.make [i64; 2] v2 v0;
    v5.[[i64; 2]; 2] = agg.make [[i64; 2]; 2] v4 zero.[i64; 2];
    return v5;
}

# A chain of phis follows the block's phis. The outer chain also inserts the
# later `v7`, so it stays after it.
# sameln: func private %after_phis(v0.i64, v1.i1) -> [[i64; 2]; 2] {
# check: block3:
# nextln: v2.i64 = phi
# nextln: v3.i64 = phi
# nextln: v5.[i64; 2] = agg.make [i64; 2] v2 v3;
# nextln: v6.i64 = mul v2 v3;
# nextln: v7.[i64; 2] = agg.make [i64; 2] v6 0.i64;
# nextln: v9.[[i64; 2]; 2] = agg.make [[i64; 2]; 2] v7 v5;
func private %after_phis(v0.i64, v1.i1) -> [[i64; 2]; 2] {
block0:
    br v1 block1 block2;

block1:
    jump block3;

block2:
    jump block3;

block3:
    v2.i64 = phi (v0 block1) (1.i64 block2);
    v3.i64 = phi (2.i64 block1) (v0 block2);
    v6.i64 = mul v2 v3;
    v7.[i64; 2] = agg.make [i64; 2] v6 0.i64;
    v5.[i64; 2] = agg.make [i64; 2] v2 v3;
    v9.[[i64; 2]; 2] = agg.make [[i64; 2]; 2] v7 v5;
    return v9;
}

# A chain stays in its loop, and one whose result is stored stays put.
# sameln: func private %stays(v0.i64, v1.i1, v2.*[i64; 2]) -> [[i64; 2]; 2] {
# check: block1:
# nextln: v3.[i64; 2] = agg.make [i64; 2] v0 0.i64;
# check: block2:
# nextln: v5.[i64; 2] = agg.make [i64; 2] 0.i64 v0;
# nextln: mstore v2 v5 [i64; 2];
func private %stays(v0.i64, v1.i1, v2.*[i64; 2]) -> [[i64; 2]; 2] {
block0:
    jump block1;

block1:
    v3.[i64; 2] = agg.make [i64; 2] v0 0.i64;
    v4.[[i64; 2]; 2] = agg.make [[i64; 2]; 2] v3 zero.[i64; 2];
    br v1 block1 block2;

block2:
    v5.[i64; 2] = agg.make [i64; 2] 0.i64 v0;
    mstore v2 v5 [i64; 2];
    return v4;
}
