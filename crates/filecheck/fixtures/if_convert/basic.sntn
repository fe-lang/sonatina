target = "evm-ethereum-osaka"

# A triangle through an empty block: the join's phi selects.
# regex: SEL=\bv\d+\b
# sameln: func public %triangle(v0.i1, v1.i64, v2.i64) -> i64 {
# check:   block0:
# nextln:      jump block2;
# check:   block2:
# nextln:      $SEL.i64 = select v0 v1 v2;
# nextln:      return $SEL;
# not:     block1:
func public %triangle(v0.i1, v1.i64, v2.i64) -> i64 {
block0:
    br v0 block1 block2;

block1:
    jump block2;

block2:
    v3.i64 = phi (v1 block1) (v2 block0);
    return v3;
}

# A diamond whose arms compute: the arms run before the jump.
# regex: SEL=\bv\d+\b
# sameln: func public %diamond_with_work(v0.i1, v1.i64, v2.i64) -> i64 {
# check:   block0:
# nextln:      v3.i64 = add v1 v2;
# nextln:      v4.i64 = sub v1 v2;
# nextln:      jump block3;
# check:   block3:
# nextln:      $SEL.i64 = select v0 v3 v4;
# nextln:      return $SEL;
func public %diamond_with_work(v0.i1, v1.i64, v2.i64) -> i64 {
block0:
    br v0 block1 block2;

block1:
    v3.i64 = add v1 v2;
    jump block3;

block2:
    v4.i64 = sub v1 v2;
    jump block3;

block3:
    v5.i64 = phi (v3 block1) (v4 block2);
    return v5;
}

# Several phis each select; one taking the same value from both needs none.
# sameln: func public %several_phis(v0.i1, v1.i8, v2.i8, v3.i256) -> i256 {
# check:       select v0 v1 v2;
# nextln:      select v0 v3 0.i256;
# not:         phi
func public %several_phis(v0.i1, v1.i8, v2.i8, v3.i256) -> i256 {
block0:
    br v0 block1 block2;

block1:
    jump block2;

block2:
    v4.i8 = phi (v1 block1) (v2 block0);
    v5.i256 = phi (v3 block1) (0.i256 block0);
    v6.i8 = phi (v1 block1) (v1 block0);
    v7.i256 = zext v4 i256;
    v8.i256 = add v7 v5;
    v9.i256 = zext v6 i256;
    v10.i256 = add v8 v9;
    return v10;
}

# Instructions with effects stay behind their branch.
# sameln: func public %effects_stay(v0.i1, v1.i256) -> i256 {
# check:       br v0 block1 block2;
func public %effects_stay(v0.i1, v1.i256) -> i256 {
block0:
    br v0 block1 block2;

block1:
    v2.i256 = mload v1 i256;
    jump block2;

block2:
    v3.i256 = phi (v2 block1) (0.i256 block0);
    return v3;
}

# A join entered from elsewhere too keeps its branch.
# sameln: func public %join_entered_elsewhere(v0.i1, v1.i1, v2.i64) -> i64 {
# check:       br v1 block2 block3;
func public %join_entered_elsewhere(v0.i1, v1.i1, v2.i64) -> i64 {
block0:
    br v0 block1 block3;

block1:
    br v1 block2 block3;

block2:
    jump block3;

block3:
    v3.i64 = phi (1.i64 block0) (2.i64 block1) (v2 block2);
    return v3;
}

# A multiplication wider than a word stays on its path: a square-and-multiply
# loop would multiply on every bit.
# sameln: func public %wide_multiply_stays(v0.i1, v1.i256, v2.i256) -> i256 {
# check:       br v0 block1 block2;
func public %wide_multiply_stays(v0.i1, v1.i256, v2.i256) -> i256 {
block0:
    br v0 block1 block2;

block1:
    v3.i256 = mul v1 v2;
    jump block2;

block2:
    v4.i256 = phi (v3 block1) (v1 block0);
    return v4;
}

# An i256 addition is four word operations, within an arm's budget; two are
# eight, beyond it.
# sameln: func public %wide_add_converts(v0.i1, v1.i256, v2.i256) -> i256 {
# check:       v3.i256 = add v1 v2;
# nextln:      jump block2;
func public %wide_add_converts(v0.i1, v1.i256, v2.i256) -> i256 {
block0:
    br v0 block1 block2;

block1:
    v3.i256 = add v1 v2;
    jump block2;

block2:
    v4.i256 = phi (v3 block1) (v1 block0);
    return v4;
}

# sameln: func public %two_wide_adds_stay(v0.i1, v1.i256, v2.i256) -> i256 {
# check:       br v0 block1 block2;
func public %two_wide_adds_stay(v0.i1, v1.i256, v2.i256) -> i256 {
block0:
    br v0 block1 block2;

block1:
    v3.i256 = add v1 v2;
    v4.i256 = add v3 v2;
    jump block2;

block2:
    v5.i256 = phi (v4 block1) (v1 block0);
    return v5;
}
