target = "evm-ethereum-osaka"

# A call to a pure function costs what its callee does, so it stays behind
# its branch rather than running on both paths.
# sameln: func public %pure_call_stays(v0.i1, v1.i64) -> i64 {
# check:   block0:
# nextln:      br v0 block1 block2;
# check:   block1:
# nextln:      v2.i64 = call %square v1;
# nextln:      jump block2;
func public %pure_call_stays(v0.i1, v1.i64) -> i64 {
block0:
    br v0 block1 block2;

block1:
    v2.i64 = call %square v1;
    jump block2;

block2:
    v3.i64 = phi (v2 block1) (v1 block0);
    return v3;
}

# check:   mul v0 v0;
func public %square(v0.i64) -> i64 {
block0:
    v1.i64 = mul v0 v0;
    return v1;
}
