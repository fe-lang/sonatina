#! A shift count a guard bounds below the width is masked, so known bits see the bound.

target = "x86_64-unknown-native"

# regex: VALUE=\bv\d+\b
# sameln: func public %guarded_shift(v0.i256, v1.i256) -> i256 {
# check: $(masked=$VALUE).i256 = and v0 255.i256;
# nextln: v3.i256 = shl $masked v1;
func public %guarded_shift(v0.i256, v1.i256) -> i256 {
block0:
    v2.i1 = lt v0 256.i256;
    br v2 block1 block2;

block1:
    v3.i256 = shl v0 v1;
    return v3;

block2:
    return 0.i256;
}

# sameln: func public %unbounded_shift(v0.i256, v1.i256) -> i256 {
# not: and
func public %unbounded_shift(v0.i256, v1.i256) -> i256 {
block0:
    v2.i256 = shl v0 v1;
    return v2;
}

