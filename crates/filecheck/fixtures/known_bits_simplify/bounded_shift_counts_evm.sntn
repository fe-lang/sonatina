#! EVM shifts handle oversized counts natively, so a guarded count stays unmasked.

target = "evm-ethereum-osaka"

# sameln: func public %guarded_shift(v0.i256, v1.i256) -> i256 {
# check: v3.i256 = shl v0 v1;
# not: and
func public %guarded_shift(v0.i256, v1.i256) -> i256 {
block0:
    v2.i1 = lt v0 256.i256;
    br v2 block1 block2;

block1:
    v3.i256 = shl v0 v1;
    return v3;

block2:
    return 0.i256;
}
