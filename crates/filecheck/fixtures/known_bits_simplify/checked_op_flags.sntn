# sameln: func public %keeps_mask_before_snego_flag(v0.i8) -> i1 {
# check:       v1.i8 = and v0 -127.i8;
# nextln:      (v2.i8, v3.i1) = snego v1;
func public %keeps_mask_before_snego_flag(v0.i8) -> i1 {
block0:
    v1.i8 = and v0 -127.i8;
    (v2.i8, v3.i1) = snego v1;
    return v3;
}
