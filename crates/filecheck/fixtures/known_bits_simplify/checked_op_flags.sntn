target = "evm-ethereum-osaka"

# A checked op's overflow flag depends on every operand bit, so a mask feeding
# an op whose only used result is its flag must stay.

# sameln: func public %keeps_mask_before_uaddo_flag(v0.i8, v1.i8) -> i1 {
# check:       v2.i8 = and v0 7.i8;
# nextln:      (v3.i8, v4.i1) = uaddo v2 v1;
func public %keeps_mask_before_uaddo_flag(v0.i8, v1.i8) -> i1 {
block0:
    v2.i8 = and v0 7.i8;
    (v3.i8, v4.i1) = uaddo v2 v1;
    return v4;
}

