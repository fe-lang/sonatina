#! A shift that undoes the opposite shift by the same count is the value
#! shifted when the first shift drops only bits known zero.

target = "x86_64-unknown-native"

# sameln: func public %undoes_shl_of_zero_high_bits(v0.i64) -> i128 {
# check: v1.i128 = zext v0 i128;
# not: shr
# check: return v1;
func public %undoes_shl_of_zero_high_bits(v0.i64) -> i128 {
block0:
    v1.i128 = zext v0 i128;
    v2.i128 = shl 64.i128 v1;
    v3.i128 = shr 64.i128 v2;
    return v3;
}

# sameln: func public %keeps_shl_of_unknown_high_bits(v0.i128) -> i128 {
# check: v1.i128 = shl 64.i128 v0;
# nextln: v2.i128 = shr 64.i128 v1;
func public %keeps_shl_of_unknown_high_bits(v0.i128) -> i128 {
block0:
    v1.i128 = shl 64.i128 v0;
    v2.i128 = shr 64.i128 v1;
    return v2;
}

# The `and` stays: the `shr` reads none of the bits it clears, but once
# `shl 8 (shr 8 v1)` is `v1`, the return reads them all.
# sameln: func public %undoes_shr_of_zero_low_bits(v0.i32) -> i32 {
# check: v1.i32 = and v0 -256.i32;
# not: shl
# check: return v1;
func public %undoes_shr_of_zero_low_bits(v0.i32) -> i32 {
block0:
    v1.i32 = and v0 -256.i32;
    v2.i32 = shr 8.i32 v1;
    v3.i32 = shl 8.i32 v2;
    return v3;
}

# Different counts are not inverses.
# sameln: func public %keeps_shifts_by_different_counts(v0.i64) -> i128 {
# check: v2.i128 = shl 64.i128 v1;
# nextln: v3.i128 = shr 32.i128 v2;
func public %keeps_shifts_by_different_counts(v0.i64) -> i128 {
block0:
    v1.i128 = zext v0 i128;
    v2.i128 = shl 64.i128 v1;
    v3.i128 = shr 32.i128 v2;
    return v3;
}
