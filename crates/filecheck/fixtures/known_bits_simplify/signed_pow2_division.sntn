target = "evm-ethereum-osaka"

# sameln: func public %exact_shift(v0.i256) -> i256 {
# check: v1.i256 = shl 8.i256 v0;
# check: v2.i256 = sar 8.i256 v1;
# check: return v2;
func public %exact_shift(v0.i256) -> i256 {
block0:
 v1.i256 = shl 8.i256 v0;
 v2.i256 = evm_sdiv v1 256.i256;
 return v2;
}

# sameln: func public %exact_mask(v0.i256) -> i256 {
# check: v1.i256 = and v0 -256.i256;
# check: v2.i256 = sar 8.i256 v1;
# check: return v2;
func public %exact_mask(v0.i256) -> i256 {
block0:
 v1.i256 = and v0 -256.i256;
 v2.i256 = evm_sdiv v1 256.i256;
 return v2;
}

# sameln: func public %nonnegative(v0.i256) -> i256 {
# check: v1.i256 = and v0 57896044618658097711785492504343953926634992332820282019728792003956564819967.i256;
# check: v2.i256 = shr 8.i256 v1;
# check: return v2;
func public %nonnegative(v0.i256) -> i256 {
block0:
 v1.i256 = and v0 57896044618658097711785492504343953926634992332820282019728792003956564819967.i256;
 v2.i256 = evm_sdiv v1 256.i256;
 return v2;
}

