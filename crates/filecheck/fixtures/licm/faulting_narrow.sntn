#! An index wider than a pointer may not fit in an address, which a backend
#! may trap on, so the `gep` stays under its guard. An index of the pointer's
#! width is hoisted.

target = "wasm32-unknown-native"

# check:  block0:
# nextln:      v5.i1 = lt v1 4.i64;
# nextln:      jump block1;
# check:  block2:
# nextln:      v6.*i64 = gep v0 v1;
func public %wide_index(v0.*i64, v1.i64, v2.i64) -> i64 {
    block0:
        jump block1;

    block1:
        v3.i64 = phi (0.i64 block0) (v9 block3);
        v4.i64 = phi (0.i64 block0) (v10 block3);
        v5.i1 = lt v1 4.i64;
        br v5 block2 block3;

    block2:
        v6.*i64 = gep v0 v1;
        v7.i64 = mload v6 i64;
        v8.i64 = add v3 v7;
        jump block3;

    block3:
        v9.i64 = phi (v3 block1) (v8 block2);
        v10.i64 = add v4 1.i64;
        v11.i1 = lt v10 v2;
        br v11 block1 block4;

    block4:
        return v9;
}

# check:  block0:
# nextln:      v5.i1 = lt v1 4.i32;
# nextln:      v6.*i64 = gep v0 v1;
# nextln:      jump block1;
func public %pointer_index(v0.*i64, v1.i32, v2.i64) -> i64 {
    block0:
        jump block1;

    block1:
        v3.i64 = phi (0.i64 block0) (v9 block3);
        v4.i64 = phi (0.i64 block0) (v10 block3);
        v5.i1 = lt v1 4.i32;
        br v5 block2 block3;

    block2:
        v6.*i64 = gep v0 v1;
        v7.i64 = mload v6 i64;
        v8.i64 = add v3 v7;
        jump block3;

    block3:
        v9.i64 = phi (v3 block1) (v8 block2);
        v10.i64 = add v4 1.i64;
        v11.i1 = lt v10 v2;
        br v11 block1 block4;

    block4:
        return v9;
}
