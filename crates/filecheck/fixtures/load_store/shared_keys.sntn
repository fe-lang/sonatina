#! Keys share the expressions the IR shares: a chain of hashes or arithmetic
#! whose every step uses its predecessor twice stays linear in size, so these
#! slots are keyed, and their loads forwarded, without blowing up.

target = "evm-ethereum-osaka"

# sameln: func public %forwards_sload_at_deeply_shared_hash_slot(v0.i256) -> i256 {
# not:         evm_sload
# check:       return 42.i256;
func public %forwards_sload_at_deeply_shared_hash_slot(v0.i256) -> i256 {
    block0:
        v1.i256 = evm_keccak256_words v0 v0;
        v2.i256 = evm_keccak256_words v1 v1;
        v3.i256 = evm_keccak256_words v2 v2;
        v4.i256 = evm_keccak256_words v3 v3;
        v5.i256 = evm_keccak256_words v4 v4;
        v6.i256 = evm_keccak256_words v5 v5;
        v7.i256 = evm_keccak256_words v6 v6;
        v8.i256 = evm_keccak256_words v7 v7;
        v9.i256 = evm_keccak256_words v8 v8;
        v10.i256 = evm_keccak256_words v9 v9;
        v11.i256 = evm_keccak256_words v10 v10;
        v12.i256 = evm_keccak256_words v11 v11;
        v13.i256 = evm_keccak256_words v12 v12;
