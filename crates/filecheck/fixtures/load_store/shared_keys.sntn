        v23.i256 = add v22 v21;
        v24.i256 = xor v23 v22;
        v25.i256 = add v24 v23;
        v26.i256 = xor v25 v24;
        v27.i256 = add v26 v25;
        v28.i256 = xor v27 v26;
        v29.i256 = add v28 v27;
        v30.i256 = xor v29 v28;
        v31.i256 = add v30 v29;
        v32.i256 = xor v31 v30;
        v33.i256 = add v32 v31;
        v34.i256 = xor v33 v32;
        v35.i256 = add v34 v33;
        v36.i256 = xor v35 v34;
        v37.i256 = add v36 v35;
        v38.i256 = xor v37 v36;
        v39.i256 = add v38 v37;
        v40.i256 = xor v39 v38;
        v41.i256 = add v40 v39;
        v42.i256 = xor v41 v40;
        v43.i256 = add v42 v41;
        v44.i256 = xor v43 v42;
        v45.i256 = add v44 v43;
        v46.i256 = xor v45 v44;
        v47.i256 = add v46 v45;
        v48.i256 = xor v47 v46;
        v49.i256 = add v48 v47;
        v50.i256 = xor v49 v48;
        v51.i256 = add v50 v49;
        v52.i256 = xor v51 v50;
        v53.i256 = add v52 v51;
        v54.i256 = xor v53 v52;
        v55.i256 = add v54 v53;
        v56.i256 = xor v55 v54;
        v57.i256 = add v56 v55;
        v58.i256 = xor v57 v56;
        v59.i256 = add v58 v57;
        v60.i256 = xor v59 v58;
        v61.i256 = add v60 v59;
        v62.i256 = xor v61 v60;
        v63.i256 = add v62 v61;
        v64.i256 = xor v63 v62;
        v65.i256 = add v64 v63;
        evm_sstore v65 42.i256;
        v66.i256 = evm_sload v65;
        return v66;
}
