# sameln: func public %forwards_sload_at_deeply_shared_arith_slot(v0.i256, v1.i256) -> i256 {
# not:         evm_sload
# check:       return 42.i256;
func public %forwards_sload_at_deeply_shared_arith_slot(v0.i256, v1.i256) -> i256 {
    block0:
        v2.i256 = xor v1 v0;
        v3.i256 = add v2 v1;
        v4.i256 = xor v3 v2;
        v5.i256 = add v4 v3;
        v6.i256 = xor v5 v4;
        v7.i256 = add v6 v5;
        v8.i256 = xor v7 v6;
        v9.i256 = add v8 v7;
        v10.i256 = xor v9 v8;
        v11.i256 = add v10 v9;
