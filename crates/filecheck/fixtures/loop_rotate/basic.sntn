target = "evm-ethereum-osaka"

# check:  block0:
# nextln:     v7.i1 = lt 0.i256 v0;
# nextln:     br v7 block2 block3;
# nextln:
# nextln: block2:
# nextln:     v6.i256 = phi (0.i256 block0) (v3 block2);
# nextln:     v3.i256 = add v6 1.i256;
# nextln:     v8.i1 = lt v3 v0;
# nextln:     br v8 block2 block3;
# nextln:
# nextln: block3:
# nextln:     v9.i256 = phi (0.i256 block0) (v3 block2);
# nextln:     return v9;
func public %counter(v0.i256) -> i256 {
    block0:
        jump block1;

    block1:
        v1.i256 = phi (0.i256 block0) (v3 block2);
        v2.i1 = lt v1 v0;
        br v2 block2 block3;

    block2:
        v3.i256 = add v1 1.i256;
        jump block1;

    block3:
        return v1;
}

# check:  block0:
# nextln:     v15.i256 = shl 5.i256 0.i256;
# nextln:     v17.i1 = lt v15 v0;
# nextln:     br v17 block2 block4;
# nextln:
# nextln: block2:
# nextln:     v14.i256 = phi (0.i256 block0) (v6 block3);
# nextln:     v13.i256 = phi (v1 block0) (v7 block3);
# nextln:     v12.i256 = phi (v15 block0) (v16 block3);
# nextln:     v7.i256 = add v13 v12;
# nextln:     jump block3;
# nextln:
# nextln: block3:
# nextln:     v6.i256 = add v14 1.i256;
# nextln:     v16.i256 = shl 5.i256 v6;
# nextln:     v18.i1 = lt v16 v0;
# nextln:     br v18 block2 block4;
# nextln:
# nextln: block4:
# nextln:     v20.i256 = phi (v1 block0) (v7 block3);
# nextln:     v19.i256 = phi (v15 block0) (v16 block3);
# nextln:     v8.i256 = add v20 v19;
# nextln:     return v8;
func public %body_uses_header_inst(v0.i256, v1.i256) -> i256 {
    block0:
        jump block1;

    block1:
        v2.i256 = phi (0.i256 block0) (v6 block3);
        v3.i256 = phi (v1 block0) (v7 block3);
        v4.i256 = shl 5.i256 v2;
        v5.i1 = lt v4 v0;
        br v5 block2 block4;

    block2:
        v7.i256 = add v3 v4;
        jump block3;

    block3:
        v6.i256 = add v2 1.i256;
        jump block1;

    block4:
        v8.i256 = add v3 v4;
        return v8;
}

# check:  block0:
# nextln:     v7.i1 = is_zero v0;
# nextln:     br v7 block3 block2;
# nextln:
# nextln: block2:
# nextln:     v6.i256 = phi (v0 block0) (v3 block2);
# nextln:     v3.i256 = shr 1.i256 v6;
# nextln:     v8.i1 = is_zero v3;
# nextln:     br v8 block3 block2;
# nextln:
# nextln: block3:
# nextln:     return 7.i256;
func public %exit_on_zero(v0.i256) -> i256 {
    block0:
        jump block1;

    block1:
        v1.i256 = phi (v0 block0) (v3 block2);
        v2.i1 = is_zero v1;
        br v2 block3 block2;

    block2:
        v3.i256 = shr 1.i256 v1;
        jump block1;

    block3:
        return 7.i256;
}

# check:  block0:
# nextln:     v12.i1 = lt 0.i256 v0;
# nextln:     br v12 block2 block4;
# nextln:
# nextln: block2:
# nextln:     v11.i256 = phi (0.i256 block0) (v5 block3);
# nextln:     v4.i1 = eq v11 v1;
# nextln:     br v4 block4 block3;
# nextln:
# nextln: block3:
# nextln:     v5.i256 = add v11 1.i256;
# nextln:     v13.i1 = lt v5 v0;
# nextln:     br v13 block2 block4;
# nextln:
# nextln: block4:
# nextln:     v14.i256 = phi (0.i256 block0) (v5 block3) (v11 block2);
# nextln:     v6.i256 = phi (100.i256 block2) (0.i256 block0) (v5 block3);
# nextln:     v7.i256 = add v6 v14;
# nextln:     return v7;
func public %break_shares_exit(v0.i256, v1.i256) -> i256 {
    block0:
        jump block1;

    block1:
        v2.i256 = phi (0.i256 block0) (v5 block3);
        v3.i1 = lt v2 v0;
        br v3 block2 block4;

    block2:
        v4.i1 = eq v2 v1;
        br v4 block4 block3;

    block3:
        v5.i256 = add v2 1.i256;
        jump block1;

    block4:
        v6.i256 = phi (v2 block1) (100.i256 block2);
        v7.i256 = add v6 v2;
        return v7;
}

# check:  block0:
# nextln:     v14.i1 = lt 0.i256 v2;
# nextln:     br v14 block2 block3;
# nextln:
# nextln: block2:
# nextln:     v13.i256 = phi (v0 block0) (v12 block2);
# nextln:     v12.i256 = phi (v1 block0) (v13 block2);
# nextln:     v11.i256 = phi (0.i256 block0) (v6 block2);
# nextln:     v6.i256 = add v11 1.i256;
# nextln:     v15.i1 = lt v6 v2;
# nextln:     br v15 block2 block3;
# nextln:
# nextln: block3:
# nextln:     v17.i256 = phi (v0 block0) (v12 block2);
# nextln:     v16.i256 = phi (v1 block0) (v13 block2);
# nextln:     v8.i256 = sub v17 v16;
# nextln:     return v8;
func public %swapped_phis(v0.i256, v1.i256, v2.i256) -> i256 {
    block0:
        jump block1;

    block1:
        v3.i256 = phi (v0 block0) (v4 block2);
        v4.i256 = phi (v1 block0) (v3 block2);
        v5.i256 = phi (0.i256 block0) (v6 block2);
        v7.i1 = lt v5 v2;
        br v7 block2 block3;

    block2:
        v6.i256 = add v5 1.i256;
        jump block1;

    block3:
        v8.i256 = sub v3 v4;
        return v8;
}

# check:  block0:
# nextln:     v14.i1 = lt 0.i256 v0;
# nextln:     br v14 block6 block5;
# nextln:
# nextln: block6:
# nextln:     v13.i256 = phi (0.i256 block0) (v6 block4);
# nextln:     v11.i1 = lt 0.i256 v13;
# nextln:     br v11 block3 block4;
# nextln:
# nextln: block3:
# nextln:     v10.i256 = phi (0.i256 block6) (v5 block3);
# nextln:     v5.i256 = add v10 1.i256;
# nextln:     v12.i1 = lt v5 v13;
# nextln:     br v12 block3 block4;
# nextln:
# nextln: block4:
# nextln:     v6.i256 = add v13 1.i256;
# nextln:     v15.i1 = lt v6 v0;
# nextln:     br v15 block6 block5;
# nextln:
# nextln: block5:
# nextln:     v16.i256 = phi (0.i256 block0) (v6 block4);
# nextln:     return v16;
func public %nested(v0.i256) -> i256 {
    block0:
        jump block1;

    block1:
        v1.i256 = phi (0.i256 block0) (v6 block4);
        v2.i1 = lt v1 v0;
        br v2 block2 block5;

    block2:
        v3.i256 = phi (0.i256 block1) (v5 block3);
        v4.i1 = lt v3 v1;
        br v4 block3 block4;

    block3:
        v5.i256 = add v3 1.i256;
        jump block2;

    block4:
        v6.i256 = add v1 1.i256;
        jump block1;

    block5:
        return v1;
}

# A header entered from two blocks gets one preheader that merges their
# values and holds the guard.
# check:  block0:
# nextln:     br v1 block1 block2;
# nextln:
# nextln: block1:
# nextln:     jump block6;
# nextln:
# nextln: block2:
# nextln:     jump block6;
# nextln:
# nextln: block6:
# nextln:     v8.i256 = phi (0.i256 block1) (5.i256 block2);
# nextln:     v10.i1 = lt v8 v0;
# nextln:     br v10 block4 block5;
# nextln:
# nextln: block4:
# nextln:     v9.i256 = phi (v8 block6) (v4 block4);
# nextln:     v4.i256 = add v9 1.i256;
# nextln:     v11.i1 = lt v4 v0;
# nextln:     br v11 block4 block5;
# nextln:
# nextln: block5:
# nextln:     v12.i256 = phi (v8 block6) (v4 block4);
# nextln:     return v12;
func public %two_entries(v0.i256, v1.i1) -> i256 {
    block0:
        br v1 block1 block2;

    block1:
        jump block3;

    block2:
        jump block3;

    block3:
        v2.i256 = phi (0.i256 block1) (5.i256 block2) (v4 block4);
        v3.i1 = lt v2 v0;
        br v3 block4 block5;

    block4:
        v4.i256 = add v2 1.i256;
        jump block3;

    block5:
        return v2;
}
