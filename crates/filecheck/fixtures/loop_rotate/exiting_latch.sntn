target = "evm-ethereum-osaka"

# check:  block0:
# nextln:     v8.i1 = lt 0.i256 v0;
# nextln:     br v8 block2 block3;
# nextln:
# nextln: block5:
# nextln:     v9.i1 = lt v3 v0;
# nextln:     br v9 block2 block3;
# nextln:
# nextln: block2:
# nextln:     v7.i256 = phi (0.i256 block0) (v3 block5);
# nextln:     (v3.i256, v4.i1) = uaddo v7 1.i256;
# nextln:     br v4 block4 block5;
# nextln:
# nextln: block3:
# nextln:     v10.i256 = phi (0.i256 block0) (v3 block5);
# nextln:     return v10;
func public %checked_counter(v0.i256) -> i256 {
    block0:
        jump block1;

    block1:
        v1.i256 = phi (0.i256 block0) (v3 block2);
        v2.i1 = lt v1 v0;
        br v2 block2 block3;

    block2:
        (v3.i256, v4.i1) = uaddo v1 1.i256;
        br v4 block4 block1;

    block3:
        return v1;

    block4:
        evm_revert 0.i256 0.i256;
}
