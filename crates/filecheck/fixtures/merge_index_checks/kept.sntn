#! Runs of bounds checks that stay apart: a bound that is not a constant,
#! something observable between two checks, checks that fail differently,
#! or signed compares.

target = "evm-ethereum-osaka"

declare external %report_panic(i256);
declare external %fx();

func private %pure(v0.i8) -> i8 {
block0:
    return v0;
}

# A bound read from memory: `b < n - 1` would wrap for `n = 0`, and
# `b + 1 < n` for the type's maximum `b`.
# sameln: func private %loaded_bound(v0.objref<[i8; 32]>, v1.objref<i64>, v2.i64) -> i8 {
# check: v4.i1 = lt v2 v3;
# check: br v4 block2 block1;
# check: br v9 block3 block1;
func private %loaded_bound(v0.objref<[i8; 32]>, v1.objref<i64>, v2.i64) -> i8 {
block0:
    v3.i64 = obj.load v1;
    v4.i1 = lt v2 v3;
    br v4 block2 block1;

block1:
    call %report_panic 50.i256;
    unreachable;

block2:
    v5.objref<i8> = obj.index v0 v2;
    v6.i8 = obj.load v5;
    v7.i64 = add v2 1.i64;
    v9.i1 = lt v7 v3;
    br v9 block3 block1;

block3:
    v10.objref<i8> = obj.index v0 v7;
    v11.i8 = obj.load v10;
    v12.i8 = xor v6 v11;
    return v12;
}

# A store between the checks: a failing second check comes after the store.
# sameln: func private %store_between(v0.objref<[i8; 32]>, v1.i64, v2.i8) {
# check: v3.i1 = lt v1 32.i64;
# check: br v3 block2 block1;
# check: br v6 block3 block1;
func private %store_between(v0.objref<[i8; 32]>, v1.i64, v2.i8) {
block0:
    v3.i1 = lt v1 32.i64;
    br v3 block2 block1;

block1:
    call %report_panic 50.i256;
    unreachable;

block2:
    v4.objref<i8> = obj.index v0 v1;
    obj.store v4 v2;
    v5.i64 = add v1 1.i64;
    v6.i1 = lt v5 32.i64;
    br v6 block3 block1;

block3:
    v7.objref<i8> = obj.index v0 v5;
    obj.store v7 v2;
    return;
}

# A call between the checks.
# sameln: func private %call_between(v0.objref<[i8; 32]>, v1.i64) -> i8 {
# check: v2.i1 = lt v1 32.i64;
# check: br v2 block2 block1;
# check: br v6 block3 block1;
func private %call_between(v0.objref<[i8; 32]>, v1.i64) -> i8 {
block0:
    v2.i1 = lt v1 32.i64;
    br v2 block2 block1;

block1:
    call %report_panic 50.i256;
    unreachable;

block2:
    v3.objref<i8> = obj.index v0 v1;
    v4.i8 = obj.load v3;
    call %fx;
    v5.i64 = add v1 1.i64;
    v6.i1 = lt v5 32.i64;
    br v6 block3 block1;

block3:
    v7.objref<i8> = obj.index v0 v5;
    v8.i8 = obj.load v7;
    v9.i8 = xor v4 v8;
    return v9;
}

# The checks fail to different blocks.
# sameln: func private %different_failures(v0.objref<[i8; 32]>, v1.i64) -> i8 {
# check: v2.i1 = lt v1 32.i64;
# check: br v2 block2 block1;
# check: br v6 block4 block3;
func private %different_failures(v0.objref<[i8; 32]>, v1.i64) -> i8 {
block0:
    v2.i1 = lt v1 32.i64;
    br v2 block2 block1;

block1:
    call %report_panic 50.i256;
    unreachable;

block2:
    v3.objref<i8> = obj.index v0 v1;
    v4.i8 = obj.load v3;
    v5.i64 = add v1 1.i64;
    v6.i1 = lt v5 32.i64;
    br v6 block4 block3;

block3:
    call %report_panic 51.i256;
    unreachable;

block4:
    v7.objref<i8> = obj.index v0 v5;
    v8.i8 = obj.load v7;
    v9.i8 = xor v4 v8;
    return v9;
}

# The checks fail to one block with different arguments.
# sameln: func private %different_failure_args(v0.objref<[i8; 32]>, v1.i64) -> i8 {
# check: v2.i1 = lt v1 32.i64;
# check: br v2 block2 block1;
# check: br v6 block3 block1;
func private %different_failure_args(v0.objref<[i8; 32]>, v1.i64) -> i8 {
block0:
    v2.i1 = lt v1 32.i64;
    br v2 block2 block1;

block1:
    v10.i256 = phi (50.i256 block0) (51.i256 block2);
    call %report_panic v10;
    unreachable;

block2:
    v3.objref<i8> = obj.index v0 v1;
    v4.i8 = obj.load v3;
    v5.i64 = add v1 1.i64;
    v6.i1 = lt v5 32.i64;
    br v6 block3 block1;

block3:
    v7.objref<i8> = obj.index v0 v5;
    v8.i8 = obj.load v7;
    v9.i8 = xor v4 v8;
    return v9;
}

# A call between the checks, even to a function without effects.
# sameln: func private %pure_call_between(v0.objref<[i8; 32]>, v1.i64) -> i8 {
# check: v2.i1 = lt v1 32.i64;
# check: br v2 block2 block1;
# check: br v7 block3 block1;
func private %pure_call_between(v0.objref<[i8; 32]>, v1.i64) -> i8 {
block0:
    v2.i1 = lt v1 32.i64;
    br v2 block2 block1;

block1:
    call %report_panic 50.i256;
    unreachable;

block2:
    v3.objref<i8> = obj.index v0 v1;
    v4.i8 = obj.load v3;
    v5.i8 = call %pure v4;
    v6.i64 = add v1 1.i64;
    v7.i1 = lt v6 32.i64;
    br v7 block3 block1;

block3:
    v8.objref<i8> = obj.index v0 v6;
    v9.i8 = obj.load v8;
    v10.i8 = xor v5 v9;
    return v10;
}

# Signed compares.
# sameln: func private %signed_compares(v0.objref<[i8; 32]>, v1.i64) -> i8 {
# check: v2.i1 = slt v1 32.i64;
# check: br v2 block2 block1;
# check: br v6 block3 block1;
func private %signed_compares(v0.objref<[i8; 32]>, v1.i64) -> i8 {
block0:
    v2.i1 = slt v1 32.i64;
    br v2 block2 block1;

block1:
    call %report_panic 50.i256;
    unreachable;

block2:
    v3.objref<i8> = obj.index v0 v1;
    v4.i8 = obj.load v3;
    v5.i64 = add v1 1.i64;
    v6.i1 = slt v5 32.i64;
    br v6 block3 block1;

block3:
    v7.objref<i8> = obj.index v0 v5;
    v8.i8 = obj.load v7;
    v9.i8 = xor v4 v8;
    return v9;
}
