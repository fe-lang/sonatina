target = "evm-ethereum-osaka"

# sameln: func public %lane_of_counted_byte() -> i64 {
# not:         br v3
func public %lane_of_counted_byte() -> i64 {
block0:
    jump block1;

block1:
    v0.i64 = phi (0.i64 block0) (v4 block2);
    v2.i64 = shr 3.i64 v0;
    v3.i1 = lt v2 4.i64;
    br v3 block2 block3;

block2:
    v4.i64 = add v0 1.i64;
    v5.i1 = lt v4 32.i64;
    br v5 block1 block4;

block3:
    return 999.i64;

block4:
    return v2;
}

# sameln: func public %masked_index_in_range(v0.i64) -> i64 {
# not:         br v2
func public %masked_index_in_range(v0.i64) -> i64 {
block0:
    v1.i64 = and v0 15.i64;
    v2.i1 = lt v1 16.i64;
    br v2 block1 block2;

block1:
    return v1;

block2:
    return 999.i64;
}

# sameln: func public %remainder_below_divisor(v0.i64, v1.i64) -> i64 {
# check:       br v3
func public %remainder_below_divisor(v0.i64, v1.i64) -> i64 {
block0:
    v2.i64 = evm_umod v0 v1;
    v3.i1 = lt v2 16.i64;
    br v3 block1 block2;

block1:
    return v2;

block2:
    return 999.i64;
}
