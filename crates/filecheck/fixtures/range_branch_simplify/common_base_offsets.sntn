#! Offsets of one base that cannot wrap compare as their offsets: once a
#! guard proves `len >= 2`, `len - 1` and `len - 2` both lie below `len`.

target = "evm-ethereum-osaka"

# sameln: func public %guarded_top_indices_stay_below_the_length(v0.i64) -> i64 {
# not:         br v4
# not:         br v6
# not:         br v7
# not:         br v8
# check:       return v5;
func public %guarded_top_indices_stay_below_the_length(v0.i64) -> i64 {
block0:
    v1.i1 = lt v0 2.i64;
    br v1 block1 block2;

block1:
    return 0.i64;

block2:
    v2.i64 = sub v0 1.i64;
    v3.i64 = sub v0 2.i64;
    v4.i1 = lt v2 v0;
    br v4 block4 block3;

block3:
    return 1.i64;

block4:
    v5.i64 = add v3 v2;
    v6.i1 = lt v3 v0;
    br v6 block5 block3;

block5:
    v7.i1 = gt v2 v0;
    br v7 block3 block6;

block6:
    v8.i1 = lt v3 v2;
    br v8 block7 block3;

block7:
    return v5;
}

# sameln: func public %unguarded_decrement_keeps_its_check(v0.i64) -> i64 {
# check:       br v2 block2 block1;
func public %unguarded_decrement_keeps_its_check(v0.i64) -> i64 {
block0:
    v1.i64 = sub v0 1.i64;
    v2.i1 = lt v1 v0;
    br v2 block2 block1;

block1:
    return 1.i64;

block2:
    return v1;
}

# sameln: func public %chained_offsets_reach_their_base(v0.i64) -> i64 {
# not:         br v4
# check:       return v3;
func public %chained_offsets_reach_their_base(v0.i64) -> i64 {
block0:
    v1.i1 = lt v0 3.i64;
    br v1 block1 block2;

block1:
    return 0.i64;

block2:
    v2.i64 = sub v0 1.i64;
    v3.i64 = sub v2 2.i64;
    v4.i1 = lt v3 v0;
    br v4 block4 block3;

block3:
    return 1.i64;

block4:
    return v3;
}
