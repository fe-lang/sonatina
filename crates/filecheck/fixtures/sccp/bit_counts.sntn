target = "evm-ethereum-osaka"

# Zero counts to the width, all ones to no zeros.
# sameln: func public %counts_i1() -> (i1, i1, i1, i1) {
# nextln:     block0:
# nextln:         return (1.i1, 1.i1, 0.i1, 0.i1);
func public %counts_i1() -> (i1, i1, i1, i1) {
    block0:
        v0.i1 = clz 0.i1;
        v1.i1 = ctz 0.i1;
        v2.i1 = clz 1.i1;
        v3.i1 = ctz 1.i1;
        return (v0, v1, v2, v3);
}

# sameln: func public %counts_i8() -> (i8, i8, i8, i8, i8, i8) {
