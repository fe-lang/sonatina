    block0:
        v0.i8 = clz 0.i8;
        v1.i8 = ctz 0.i8;
        v2.i8 = clz -1.i8;
        v3.i8 = ctz -1.i8;
        v4.i8 = clz 16.i8;
        v5.i8 = ctz 16.i8;
        return (v0, v1, v2, v3, v4, v5);
}

