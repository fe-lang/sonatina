#! `black_box` interprets as its operand, but SCCP must not fold through it.

target = "evm-ethereum-london"

# sameln: func public %black_box_opaque() -> i32 {
# nextln:     block0:
# nextln:         v0.i32 = black_box 5.i32;
# nextln:         v1.i32 = add v0 3.i32;
# nextln:         return v1;
func public %black_box_opaque() -> i32 {
    block0:
        v0.i32 = black_box 5.i32;
        v1.i32 = add v0 3.i32;
        return v1;
}
