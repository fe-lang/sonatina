#! A `freeze` of a constant, or of another freeze, is that value. Any other
#! value may be unspecified: a parameter, a read, a call result, or a value
#! computed from one, so its `freeze` stays.

target = "evm-ethereum-osaka"

# sameln: func public %drops_constant_freeze() -> i256 {
# not: freeze
# check: return 7.i256;
func public %drops_constant_freeze() -> i256 {
    block0:
        v0.i256 = add 3.i256 4.i256;
        v1.i256 = freeze v0;
        return v1;
}

# sameln: func public %drops_freeze_of_freeze(v0.i256) -> i256 {
# check: v1.i256 = freeze v0;
# check: return v1;
func public %drops_freeze_of_freeze(v0.i256) -> i256 {
    block0:
        v1.i256 = freeze v0;
        v2.i256 = freeze v1;
        return v2;
}

# sameln: func public %keeps_argument_freeze(v0.i256) -> i256 {
# check: v1.i256 = freeze v0;
# check: return v1;
func public %keeps_argument_freeze(v0.i256) -> i256 {
    block0:
        v1.i256 = freeze v0;
        return v1;
}

# sameln: func public %keeps_undef_freeze(v0.i1, v1.i256) -> i256 {
# check: v3.i256 = freeze v2;
func public %keeps_undef_freeze(v0.i1, v1.i256) -> i256 {
    block0:
        br v0 block1 block2;

    block1:
        jump block2;

    block2:
        v2.i256 = phi (undef.i256 block0) (v1 block1);
        v3.i256 = freeze v2;
        return v3;
}
