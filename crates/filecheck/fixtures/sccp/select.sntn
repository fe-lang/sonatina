target = "evm-ethereum-osaka"

# A known condition picks its value.
# sameln: func public %select_on_known_condition(v0.i64, v1.i64) -> i64 {
# check:       return v1;
func public %select_on_known_condition(v0.i64, v1.i64) -> i64 {
block0:
    v2.i64 = select 0.i1 v0 v1;
    return v2;
}

# A choice between one value is that value.
# sameln: func public %select_between_one_value(v0.i1, v1.i64) -> i64 {
# check:       return v1;
func public %select_between_one_value(v0.i1, v1.i64) -> i64 {
block0:
    v2.i64 = select v0 v1 v1;
    return v2;
}
