target = "evm-ethereum-osaka"

# sameln: func public %eq_chain(v0.i32) -> i64 {
# check:       br_table v0 block4 (1.i32 block5) (2.i32 block6) (3.i32 block7);
# not:         eq
func public %eq_chain(v0.i32) -> i64 {
block0:
    v1.i1 = eq v0 1.i32;
    br v1 block5 block1;

block1:
    v2.i1 = eq v0 2.i32;
    br v2 block6 block2;

block2:
    v3.i1 = eq v0 3.i32;
    br v3 block7 block4;

block4:
    return 0.i64;

block5:
    return 10.i64;

block6:
    return 20.i64;

block7:
    return 30.i64;
}

# Signed range tests expand into one key per value; `v0` in 4..=7 and 11.
# sameln: func public %signed_ranges(v0.i32) -> i64 {
# check:       br_table v0 block9 (2.i32 block2) (4.i32 block2) (5.i32 block2) (6.i32 block2) (7.i32 block2) (8.i32 block10) (11.i32 block2);
# not:         slt
func public %signed_ranges(v0.i32) -> i64 {
block0:
    v1.i1 = eq v0 2.i32;
    br v1 block2 block7;

block2:
    return 5.i64;

block6:
    v2.i1 = eq v0 11.i32;
    br v2 block2 block11;

block11:
    v3.i1 = eq v0 8.i32;
    br v3 block10 block9;

block7:
    v4.i1 = slt v0 4.i32;
    br v4 block6 block8;

block8:
    v5.i1 = slt 7.i32 v0;
    br v5 block6 block2;

block9:
    return 0.i64;

block10:
    return 8.i64;
}

# A test block reached from two region blocks is absorbed once; `is_zero`
# tests zero, and unsigned tests on the left constant are mirrored.
# sameln: func public %shared_test_and_is_zero(v0.i8) -> i64 {
# check:       br_table v0 block5 (0.i8 block3) (9.i8 block4) (-56.i8 block4) (-55.i8 block4);
func public %shared_test_and_is_zero(v0.i8) -> i64 {
block0:
    v1.i1 = is_zero v0;
    br v1 block3 block1;

block1:
    v2.i1 = lt -57.i8 v0;
    br v2 block6 block2;

block6:
    v3.i1 = lt v0 -54.i8;
    br v3 block4 block5;

block2:
    v4.i1 = eq v0 9.i8;
    br v4 block4 block5;

block3:
    return 1.i64;

block4:
    return 2.i64;

block5:
    return 3.i64;
}

# A leaf's phi takes the value all region predecessors agree on from the
# root instead, which leaves it trivial here.
# sameln: func public %leaf_phi_agrees(v0.i64, v1.i64) -> i64 {
# check:       br_table v0 block3 (1.i64 block4) (2.i64 block4) (3.i64 block5);
# check:   block4:
# nextln:      return v1;
func public %leaf_phi_agrees(v0.i64, v1.i64) -> i64 {
block0:
    v2.i1 = eq v0 1.i64;
    br v2 block4 block1;

block1:
    v3.i1 = eq v0 2.i64;
    br v3 block4 block2;

block2:
    v5.i1 = eq v0 3.i64;
    br v5 block5 block3;

block3:
    return 0.i64;

block4:
    v4.i64 = phi (v1 block0) (v1 block1);
    return v4;

block5:
    return 7.i64;
}

# Edges that bring a leaf's phi different inputs enter it through blocks of
# their own.
# sameln: func public %leaf_phi_inputs_differ(v0.i64, v1.i64) -> i64 {
# check:       br_table v0 block3 (1.i64 block4) (2.i64 block6) (3.i64 block5);
# check:   block6:
# nextln:      jump block4;
# check:       v4.i64 = phi (v1 block0) (5.i64 block6);
func public %leaf_phi_inputs_differ(v0.i64, v1.i64) -> i64 {
block0:
    v2.i1 = eq v0 1.i64;
    br v2 block4 block1;

block1:
    v3.i1 = eq v0 2.i64;
    br v3 block4 block2;

block2:
    v5.i1 = eq v0 3.i64;
    br v5 block5 block3;

block3:
    return 0.i64;

block4:
    v4.i64 = phi (v1 block0) (5.i64 block1);
    return v4;

block5:
    return 7.i64;
}

# Two comparisons are not worth a table.
# sameln: func public %two_tests(v0.i32) -> i64 {
# check:       v1.i1 = eq v0 1.i32;
# not:         br_table
func public %two_tests(v0.i32) -> i64 {
block0:
    v1.i1 = eq v0 1.i32;
    br v1 block3 block1;

block1:
    v2.i1 = eq v0 2.i32;
    br v2 block3 block2;

block2:
    return 0.i64;

block3:
    return 1.i64;
}

# A wide range would need more keys than its comparisons are worth.
# sameln: func public %wide_range(v0.i32) -> i64 {
# check:       v1.i1 = lt v0 1000.i32;
# not:         br_table
func public %wide_range(v0.i32) -> i64 {
block0:
    v1.i1 = lt v0 1000.i32;
    br v1 block1 block3;

block1:
    v2.i1 = lt v0 10.i32;
    br v2 block3 block2;

block2:
    v3.i1 = eq v0 500.i32;
    br v3 block3 block4;

block3:
    return 0.i64;

block4:
    return 1.i64;
}

# A test block that computes anything else, or is entered from outside the
# region, ends the region.
# sameln: func public %region_ends(v0.i32, v1.i1) -> i64 {
# check:       br_table v0 block2 (1.i32 block5) (2.i32 block6) (3.i32 block3);
# check:   block2:
# nextln:      v4.i64 = add 1.i64 2.i64;
# nextln:      v5.i1 = eq v0 4.i32;
# check:   block3:
# nextln:      v6.i1 = eq v0 5.i32;
func public %region_ends(v0.i32, v1.i1) -> i64 {
block0:
    br v1 block7 block8;

block7:
    v2.i1 = eq v0 1.i32;
    br v2 block5 block1;

block1:
    v3.i1 = eq v0 2.i32;
    br v3 block6 block9;

block9:
    v7.i1 = eq v0 3.i32;
    br v7 block3 block2;

block2:
    v4.i64 = add 1.i64 2.i64;
    v5.i1 = eq v0 4.i32;
    br v5 block5 block6;

block8:
    jump block3;

block3:
    v6.i1 = eq v0 5.i32;
    br v6 block5 block6;

block5:
    return 1.i64;

block6:
    return 2.i64;
}

# sameln: func public %i256_untouched(v0.i256) -> i64 {
# not:         br_table
func public %i256_untouched(v0.i256) -> i64 {
block0:
    v1.i1 = eq v0 1.i256;
    br v1 block3 block1;

block1:
    v2.i1 = eq v0 2.i256;
    br v2 block3 block2;

block2:
    v3.i1 = eq v0 3.i256;
    br v3 block3 block4;

block3:
    return 1.i64;

block4:
    return 0.i64;
}

# The shape of a `match` whose arms each produce a constant: every test
# branches to one join, whose phi takes the arm's value.
# sameln: func public %match_constants(v0.i32) -> i64 {
# check:       br_table v0 block3 (1.i32 block9) (2.i32 block10) (3.i32 block9);
# check:   block10:
# nextln:      jump block9;
# check:       v4.i64 = phi (0.i64 block3) (3.i64 block0) (5.i64 block10);
func public %match_constants(v0.i32) -> i64 {
block0:
    v1.i1 = eq v0 1.i32;
    br v1 block9 block1;

block1:
    v2.i1 = eq v0 2.i32;
    br v2 block9 block2;

block2:
    v3.i1 = eq v0 3.i32;
    br v3 block9 block3;

block3:
    jump block9;

block9:
    v4.i64 = phi (3.i64 block0) (5.i64 block1) (3.i64 block2) (0.i64 block3);
    return v4;
}
