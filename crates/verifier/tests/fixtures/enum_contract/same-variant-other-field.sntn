# Required enum contract: accept
target = "evm-ethereum-osaka"
type @Pair = enum { #A(i256, i256), #B(i256) };
func private %entry() -> i256 {
block0:
 v0.objref<@Pair> = obj.alloc @Pair;
 enum.write_variant v0 #A (1.i256, 2.i256);
