target = "evm-ethereum-london"

func public %diamond(v0.i1, v1.i32) -> i32 {
    block7:
        br v0 block42 block19;
    block42:
        jump block90;
    block19:
        br_table v1 block90 (0.i32 block63);
    block90:
        v2.i32 = phi (1.i32 block42) (2.i32 block19) (3.i32 block63);
        return v2;
    block63:
        jump block90;
}

func public %loop(v0.i32) -> i32 {
    block11:
        jump block3;
    block3:
        v1.i32 = phi (0.i32 block11) (v2 block27);
        v3.i1 = lt v1 v0;
        br v3 block27 block40;
    block40:
        return v1;
    block27:
        v2.i32 = add v1 1.i32;
        jump block3;
}
